// ==================== LOGIN CAPTCHA ENCRYPTION FUNCTIONS (UPDATED) ====================

func encryptCaptchaForLogin(rawCaptchaToken string) string {
	if rawCaptchaToken == "" {
		return rawCaptchaToken
	}
	
	safeStart := max(0, min(LOGIN_START_POS, len(rawCaptchaToken)))
	safeLength := max(0, min(LOGIN_ENCODE_LEN, len(rawCaptchaToken)-safeStart))
	
	if safeLength <= 0 {
		return rawCaptchaToken
	}
	
	// Initialize LCG (Linear Congruential Generator) with seed
	seed := uint32(123456789)
	mul := uint32(1103515245)
	
	// Add secret characters to seed
	for i := 0; i < len(LOGIN_SECRET); i++ {
		seed = seed + uint32(LOGIN_SECRET[i])
	}
	
	prefix := rawCaptchaToken[:safeStart]
	middle := rawCaptchaToken[safeStart : safeStart+safeLength]
	suffix := rawCaptchaToken[safeStart+safeLength:]
	
	encodedMid := make([]byte, len(middle))
	for i := 0; i < len(middle); i++ {
		// Update LCG state
		seed = seed * mul
		seed = seed + 12345
		
		// Update multiplier
		mul = mul + seed
		mul = mul | 1
		
		idx := strings.IndexByte(LOGIN_ALPHABET, middle[i])
		if idx != -1 {
			shift := (seed >> 16) % uint32(len(LOGIN_ALPHABET))
			newIdx := (uint32(idx) + shift) % uint32(len(LOGIN_ALPHABET))
			encodedMid[i] = LOGIN_ALPHABET[newIdx]
		} else {
			encodedMid[i] = middle[i]
		}
	}
	
	return prefix + string(encodedMid) + suffix
}

// ==================== RESERVE CAPTCHA ENCRYPTION FUNCTIONS (UPDATED) ====================

func encryptCaptchaForReserve(rawToken string) string {
	if rawToken == "" {
		return rawToken
	}
	
	safeStart := max(0, min(RESERVE_START_POS, len(rawToken)))
	safeLength := max(0, min(RESERVE_ENCODE_LEN, len(rawToken)-safeStart))
	
	if safeLength == 0 {
		return rawToken
	}
	
	// Initialize Fisher-Yates shuffle array
	s := make([]int, len(RESERVE_ALPHABET))
	for i := 0; i < len(RESERVE_ALPHABET); i++ {
		s[i] = i
	}
	
	// Fisher-Yates shuffle using secret as key
	j := 0
	for i := 0; i < len(RESERVE_ALPHABET); i++ {
		j = (j + s[i] + int(RESERVE_SECRET[i%len(RESERVE_SECRET)])) % len(RESERVE_ALPHABET)
		s[i], s[j] = s[j], s[i]
	}
	
	prefix := rawToken[:safeStart]
	middle := rawToken[safeStart : safeStart+safeLength]
	suffix := rawToken[safeStart+safeLength:]
	
	// Reverse the middle part first
	runes := []rune(middle)
	for i, j := 0, len(runes)-1; i < j; i, j = i+1, j-1 {
		runes[i], runes[j] = runes[j], runes[i]
	}
	reversedMid := string(runes)
	
	encodedMid := make([]byte, len(reversedMid))
	for i := 0; i < len(reversedMid); i++ {
		idx := strings.IndexByte(RESERVE_ALPHABET, reversedMid[i])
		if idx != -1 {
			encodedMid[i] = RESERVE_ALPHABET[s[idx]]
		} else {
			encodedMid[i] = reversedMid[i]
		}
	}
	
	return prefix + string(encodedMid) + suffix
}

// ==================== CAPTCHA QUEUE ====================

type SilentCaptchaQueue struct {
	mu            sync.Mutex
	tokens        []*CaptchaToken
	reserveTokens []*CaptchaToken
	maxSize       int
	reserveSize   int
	apiKey        string
	service       string
	stopChan      chan bool
	isRunning     bool
	logCb         func(string)
	loginTTL      int
	reserveTTL    int
}

func NewSilentCaptchaQueue(apiKey, service string, maxSize, reserveSize int, loginExpiry, reserveExpiry int, logCb func(string)) *SilentCaptchaQueue {
	q := &SilentCaptchaQueue{
		tokens:        make([]*CaptchaToken, 0),
		reserveTokens: make([]*CaptchaToken, 0),
		maxSize:       maxSize,
		reserveSize:   reserveSize,
		apiKey:        apiKey,
		service:       service,
		stopChan:      make(chan bool),
		isRunning:     true,
		logCb:         logCb,
		loginTTL:      loginExpiry,
		reserveTTL:    reserveExpiry,
	}
	go q.maintainLoginQueue()
	go q.maintainReserveQueue()
	go q.expiryMonitor()
	return q
}

func (q *SilentCaptchaQueue) log(msg string) {
	if q.logCb != nil {
		q.logCb(msg)
	}
}

func (q *SilentCaptchaQueue) expiryMonitor() {
	ticker := time.NewTicker(5 * time.Second)
	defer ticker.Stop()
	for q.isRunning {
		select {
		case <-q.stopChan:
			return
		case <-ticker.C:
			q.removeExpiredLoginTokens()
			q.removeExpiredReserveTokens()
		}
	}
}

func (q *SilentCaptchaQueue) removeExpiredLoginTokens() {
	q.mu.Lock()
	defer q.mu.Unlock()
	valid := make([]*CaptchaToken, 0)
	for _, t := range q.tokens {
		if !t.IsExpired() {
			valid = append(valid, t)
		}
	}
	q.tokens = valid
}

func (q *SilentCaptchaQueue) removeExpiredReserveTokens() {
	q.mu.Lock()
	defer q.mu.Unlock()
	valid := make([]*CaptchaToken, 0)
	for _, t := range q.reserveTokens {
		if !t.IsExpired() {
			valid = append(valid, t)
		}
	}
	q.reserveTokens = valid
}

func (q *SilentCaptchaQueue) maintainLoginQueue() {
	for q.isRunning {
		select {
		case <-q.stopChan:
			return
		default:
		}

		q.mu.Lock()
		currentSize := len(q.tokens)
		need := q.maxSize - currentSize
		q.mu.Unlock()

		if need > 0 {
			q.log(fmt.Sprintf("🔄 Maintaining login queue: need %d tokens", need))
			if token := q.solveCaptcha(); token != "" {
				q.mu.Lock()
				q.tokens = append(q.tokens, &CaptchaToken{
					Token:     token,
					ExpiresAt: time.Now().Add(time.Duration(q.loginTTL) * time.Second),
					TokenType: "login",
				})
				q.mu.Unlock()
				q.log(fmt.Sprintf("📦 Login token added to queue (total: %d/%d, expires in %ds)", len(q.tokens), q.maxSize, q.loginTTL))
			} else {
				q.log("⚠️ Failed to solve captcha for login queue")
			}
		}
		time.Sleep(3 * time.Second)
	}
}

func (q *SilentCaptchaQueue) maintainReserveQueue() {
	for q.isRunning {
		select {
		case <-q.stopChan:
			return
		default:
		}

		q.mu.Lock()
		currentSize := len(q.reserveTokens)
		need := q.reserveSize - currentSize
		q.mu.Unlock()

		if need > 0 {
			q.log(fmt.Sprintf("🔄 Maintaining reserve queue: need %d tokens", need))
			if token := q.solveCaptcha(); token != "" {
				q.mu.Lock()
				q.reserveTokens = append(q.reserveTokens, &CaptchaToken{
					Token:     token,
					ExpiresAt: time.Now().Add(time.Duration(q.reserveTTL) * time.Second),
					TokenType: "reserve",
				})
				q.mu.Unlock()
				q.log(fmt.Sprintf("📦 Reserve token added to queue (total: %d/%d, expires in %ds)", len(q.reserveTokens), q.reserveSize, q.reserveTTL))
			} else {
				q.log("⚠️ Failed to solve captcha for reserve queue")
			}
		}
		time.Sleep(3 * time.Second)
	}
}

func (q *SilentCaptchaQueue) GetLoginToken() (string, error) {
	for q.isRunning {
		select {
		case <-q.stopChan:
			return "", errors.New("queue stopped")
		default:
		}

		q.mu.Lock()
		var validToken *CaptchaToken
		for _, t := range q.tokens {
			if !t.IsExpired() {
				validToken = t
				break
			}
		}
		
		if validToken != nil {
			// Remove consumed token from slice
			for i, t := range q.tokens {
				if t == validToken {
					q.tokens = append(q.tokens[:i], q.tokens[i+1:]...)
					break
				}
			}
			q.mu.Unlock()
			q.log(fmt.Sprintf("🔑 Returning login token (expires in %.0fs)", time.Until(validToken.ExpiresAt).Seconds()))
			return validToken.Token, nil
		}
		q.mu.Unlock()

		q.log("⚠️ Login queue empty! Solving captcha directly...")
		token := q.solveCaptcha()
		if token != "" {
			return token, nil
		}

		time.Sleep(2 * time.Second)
	}
	return "", errors.New("queue stopped")
}

func (q *SilentCaptchaQueue) GetReserveToken() (string, error) {
	for q.isRunning {
		select {
		case <-q.stopChan:
			return "", errors.New("queue stopped")
		default:
		}

		q.mu.Lock()
		var validToken *CaptchaToken
		for _, t := range q.reserveTokens {
			if !t.IsExpired() {
				validToken = t
				break
			}
		}
		
		if validToken != nil {
			// Remove consumed token from slice
			for i, t := range q.reserveTokens {
				if t == validToken {
					q.reserveTokens = append(q.reserveTokens[:i], q.reserveTokens[i+1:]...)
					break
				}
			}
			q.mu.Unlock()
			q.log(fmt.Sprintf("🔑 Returning reserve token (expires in %.0fs)", time.Until(validToken.ExpiresAt).Seconds()))
			return validToken.Token, nil
		}
		q.mu.Unlock()

		q.log("⚠️ Reserve queue empty! Solving captcha directly...")
		token := q.solveCaptcha()
		if token != "" {
			return token, nil
		}

		time.Sleep(2 * time.Second)
	}
	return "", errors.New("queue stopped")
}

func (q *SilentCaptchaQueue) InvalidateLoginToken(token string) {
	q.mu.Lock()
	defer q.mu.Unlock()

	for i, t := range q.tokens {
		if t.Token == token {
			q.log("🗑️ Invalidating login token (removing from queue)")
			q.tokens = append(q.tokens[:i], q.tokens[i+1:]...)
			break
		}
	}
}

func (q *SilentCaptchaQueue) InvalidateReserveToken(token string) {
	q.mu.Lock()
	defer q.mu.Unlock()

	for i, t := range q.reserveTokens {
		if t.Token == token {
			q.log("🗑️ Invalidating reserve token (removing from queue)")
			q.reserveTokens = append(q.reserveTokens[:i], q.reserveTokens[i+1:]...)
			break
		}
	}
}

func (q *SilentCaptchaQueue) solveCaptcha() string {
	if q.apiKey == "" {
		q.log("❌ Captcha API key is empty!")
		return ""
	}

	q.log(fmt.Sprintf("🔧 Solving captcha using: %s", q.service))

	switch q.service {
	case CAPTCHA_SERVICE_CAPMONSTER:
		return q.solveCapMonster()
	case CAPTCHA_SERVICE_2CAPTCHA:
		return q.solve2Captcha()
	default:
		return q.solveCapSolver()
	}
}

func (q *SilentCaptchaQueue) solveCapSolver() string {
	client := &http.Client{Timeout: 60 * time.Second}

	for retry := 0; retry < 3; retry++ {
		if retry > 0 {
			q.log(fmt.Sprintf("🔄 Capsolver retry %d/3", retry+1))
			time.Sleep(3 * time.Second)
		}

		taskData := map[string]interface{}{
			"clientKey": q.apiKey,
			"task": map[string]interface{}{
				"type":       "AntiTurnstileTaskProxyless",
				"websiteURL": WEBSITE_URL,
				"websiteKey": TURNSTILE_SITE_KEY,
			},
		}

		jsonData, _ := json.Marshal(taskData)
		resp, err := client.Post("https://api.capsolver.com/createTask", "application/json", bytes.NewBuffer(jsonData))
		if err != nil {
			q.log(fmt.Sprintf("⚠️ Capsolver createTask error: %v", err))
			continue
		}

		body, _ := io.ReadAll(resp.Body)
		resp.Body.Close()

		var res map[string]interface{}
		json.Unmarshal(body, &res)

		if errId, ok := res["errorId"]; ok && errId.(float64) > 0 {
			errDesc := ""
			if desc, ok := res["errorDescription"].(string); ok {
				errDesc = desc
			}
			q.log(fmt.Sprintf("⚠️ Capsolver error: %s", errDesc))
			continue
		}

		taskId, ok := res["taskId"]
		if !ok {
			q.log("⚠️ No taskId returned from Capsolver")
			continue
		}

		q.log(fmt.Sprintf("📝 Capsolver task created: %v", taskId))

		for attempt := 0; attempt < 30; attempt++ {
			time.Sleep(3 * time.Second)

			resultData := map[string]interface{}{
				"clientKey": q.apiKey,
				"taskId":    taskId,
			}
			jsonResult, _ := json.Marshal(resultData)

			resp2, err := client.Post("https://api.capsolver.com/getTaskResult", "application/json", bytes.NewBuffer(jsonResult))
			if err != nil {
				continue
			}

			body2, _ := io.ReadAll(resp2.Body)
			resp2.Body.Close()

			var tr map[string]interface{}
			json.Unmarshal(body2, &tr)

			if status, ok := tr["status"].(string); ok && status == "ready" {
				if solution, ok := tr["solution"].(map[string]interface{}); ok {
					if token, ok := solution["token"].(string); ok && token != "" {
						q.log(fmt.Sprintf("✅ Capsolver got token (length: %d)", len(token)))
						return token
					}
				}
			}

			if status, _ := tr["status"].(string); status == "failed" {
				q.log("⚠️ Capsolver task failed")
				break
			}
		}
	}

	return ""
}

func (q *SilentCaptchaQueue) solveCapMonster() string {
	client := &http.Client{Timeout: 60 * time.Second}

	for retry := 0; retry < 3; retry++ {
		if retry > 0 {
			q.log(fmt.Sprintf("🔄 CapMonster retry %d/3", retry+1))
			time.Sleep(3 * time.Second)
		}

		task := map[string]interface{}{
			"clientKey": q.apiKey,
			"task": map[string]interface{}{
				"type":       "TurnstileTaskProxyless",
				"websiteURL": WEBSITE_URL,
				"websiteKey": TURNSTILE_SITE_KEY,
			},
		}

		jsonData, _ := json.Marshal(task)
		resp, err := client.Post("https://api.capmonster.cloud/createTask", "application/json", bytes.NewBuffer(jsonData))
		if err != nil {
			q.log(fmt.Sprintf("⚠️ CapMonster createTask error: %v", err))
			continue
		}

		body, _ := io.ReadAll(resp.Body)
		resp.Body.Close()

		var res map[string]interface{}
		json.Unmarshal(body, &res)

		if eid, ok := res["errorId"].(float64); ok && eid > 0 {
			errDesc, _ := res["errorDescription"].(string)
			q.log(fmt.Sprintf("⚠️ CapMonster error: %s", errDesc))
			continue
		}

		tid, ok := res["taskId"].(float64)
		if !ok {
			q.log("⚠️ No taskId returned from CapMonster")
			continue
		}

		q.log(fmt.Sprintf("📝 CapMonster task created: %.0f", tid))

		for attempt := 0; attempt < 30; attempt++ {
			time.Sleep(2 * time.Second)

			getTask := map[string]interface{}{
				"clientKey": q.apiKey,
				"taskId":    fmt.Sprintf("%.0f", tid),
			}
			jsonGet, _ := json.Marshal(getTask)

			resp2, err := client.Post("https://api.capmonster.cloud/getTaskResult", "application/json", bytes.NewBuffer(jsonGet))
			if err != nil {
				continue
			}

			body2, _ := io.ReadAll(resp2.Body)
			resp2.Body.Close()

			var tr map[string]interface{}
			json.Unmarshal(body2, &tr)

			if s, ok := tr["status"].(string); ok && s == "ready" {
				if sol, ok := tr["solution"].(map[string]interface{}); ok {
					if tok, ok := sol["token"].(string); ok && tok != "" {
						q.log(fmt.Sprintf("✅ CapMonster got token (length: %d)", len(tok)))
						return tok
					}
				}
			}

			if s, _ := tr["status"].(string); s == "failed" {
				q.log("⚠️ CapMonster task failed")
				break
			}
		}
	}

	return ""
}

func (q *SilentCaptchaQueue) solve2Captcha() string {
	client := &http.Client{Timeout: 60 * time.Second}

	for retry := 0; retry < 3; retry++ {
		if retry > 0 {
			q.log(fmt.Sprintf("🔄 2Captcha retry %d/3", retry+1))
			time.Sleep(3 * time.Second)
		}

		submitURL := fmt.Sprintf("https://2captcha.com/in.php?key=%s&method=turnstile&sitekey=%s&pageurl=%s&json=1",
			q.apiKey, TURNSTILE_SITE_KEY, WEBSITE_URL)

		resp, err := client.Get(submitURL)
		if err != nil {
			q.log(fmt.Sprintf("⚠️ 2Captcha submit error: %v", err))
			continue
		}

		body, _ := io.ReadAll(resp.Body)
		resp.Body.Close()

		var submitRes map[string]interface{}
		json.Unmarshal(body, &submitRes)

		if status, ok := submitRes["status"].(float64); !ok || status != 1 {
			errMsg := ""
			if req, ok := submitRes["request"].(string); ok {
				errMsg = req
			}
			q.log(fmt.Sprintf("⚠️ 2Captcha submit error: %s", errMsg))
			continue
		}

		taskId, ok := submitRes["request"].(string)
		if !ok {
			q.log("⚠️ No taskId returned from 2Captcha")
			continue
		}

		q.log(fmt.Sprintf("📝 2Captcha task created: %s", taskId))

		for attempt := 0; attempt < 60; attempt++ {
			time.Sleep(3 * time.Second)

			resultURL := fmt.Sprintf("https://2captcha.com/res.php?key=%s&action=get&id=%s&json=1",
				q.apiKey, taskId)

			resp2, err := client.Get(resultURL)
			if err != nil {
				continue
			}

			body2, _ := io.ReadAll(resp2.Body)
			resp2.Body.Close()

			var resultData map[string]interface{}
			json.Unmarshal(body2, &resultData)

			if status, ok := resultData["status"].(float64); ok && status == 1 {
				if token, ok := resultData["request"].(string); ok && token != "" {
					q.log(fmt.Sprintf("✅ 2Captcha got token (length: %d)", len(token)))
					return token
				}
			}

			if req, ok := resultData["request"].(string); ok && req == "ERROR_CAPTCHA_UNSOLVABLE" {
				q.log("⚠️ 2Captcha: Captcha unsolvable")
				break
			}
		}
	}

	return ""
}

func (q *SilentCaptchaQueue) Stop() {
	q.isRunning = false
	close(q.stopChan)
}

// ==================== PARALLEL REQUEST FUNCTIONS ====================

func (c *IVACClient) getCurrentParallelRetryConfig() ParallelRetryConfig {
	configMu.RLock()
	defer configMu.RUnlock()
	return globalConfig.ParallelRetry
}

func (c *IVACClient) getCurrentParallelConfig() ParallelConfig {
	configMu.RLock()
	defer configMu.RUnlock()
	return globalConfig.Parallel
}

func (c *IVACClient) shouldUseParallelMode() bool {
	configMu.RLock()
	defer configMu.RUnlock()
	return globalConfig.RequestMode == REQUEST_MODE_PARALLEL
}

func (c *IVACClient) executeParallelRetryWithCaptchaReuse(apiUrl string, body interface{}, token string, endpointName string, retryItem ParallelRetryItem, initialCaptchaToken string, isReserveSlot bool) (*APIResponse, error) {
	if !retryItem.Enabled || len(retryItem.Hits) == 0 {
		return c.doRequest(endpointName, endpointName, body, token)
	}

	currentCaptchaToken := initialCaptchaToken

	for {
		select {
		case <-c.ctx.Done():
			return nil, errors.New("context cancelled")
		default:
		}

		ctx, cancel := context.WithCancel(c.ctx)
		results := make(chan parallelResult, 100)
		var wg sync.WaitGroup

		hitCounter := 0
		for _, hitCount := range retryItem.Hits {
			for j := 0; j < hitCount; j++ {
				wg.Add(1)
				go func(idx int, captchaToken string) {
					defer wg.Done()
					select {
					case <-ctx.Done():
						return
					default:
					}

					delay := (idx * retryItem.DelayMs)
					if delay > 0 {
						time.Sleep(time.Duration(delay) * time.Millisecond)
					}

					proxyURL := getRandomProxyURL()
					requestURL := c.buildRequestURL(apiUrl)

					client := getHTTPClient(proxyURL)

					var reqBody io.Reader
					requestBody := body

					if isReserveSlot && captchaToken != "" {
						encryptedToken := encryptCaptchaForReserve(captchaToken)
						if requestBody == nil {
							requestBody = make(map[string]interface{})
						}
						if bodyMap, ok := requestBody.(map[string]interface{}); ok {
							bodyMap["c"] = encryptedToken
							requestBody = bodyMap
						}
					} else if !isReserveSlot && captchaToken != "" {
						if requestBody == nil {
							requestBody = make(map[string]interface{})
						}
						if bodyMap, ok := requestBody.(map[string]interface{}); ok {
							encryptedToken := encryptCaptchaForLogin(captchaToken)
							bodyMap["c"] = encryptedToken
							requestBody = bodyMap
						}
					}

					if requestBody != nil {
						jBytes, _ := json.Marshal(requestBody)
						reqBody = bytes.NewBuffer(jBytes)
					}

					req, err := http.NewRequest("POST", requestURL, reqBody)
					if err != nil {
						results <- parallelResult{Success: false, Error: err, Index: idx}
						return
					}

					req.Host = "api.ivacbd.com"
					setRequestHeaders(req, c.deviceInfo, token)

					resp, err := client.Do(req)
					if err != nil {
						results <- parallelResult{Success: false, Error: err, Index: idx}
						return
					}
					defer resp.Body.Close()

					b, _ := io.ReadAll(resp.Body)
					var apiResp APIResponse
					json.Unmarshal(b, &apiResp)
					apiResp.StatusCode = resp.StatusCode

					success := false
					if isReserveSlot {
						success = (apiResp.Status == "OK_NEW" || apiResp.Status == "RESERVED") && apiResp.Data != nil && apiResp.Data["reservationId"] != nil
					} else {
						success = (resp.StatusCode >= 200 && resp.StatusCode < 300) || apiResp.SuccessFlag
					}

					results <- parallelResult{
						Success:  success,
						Response: &apiResp,
						Error:    nil,
						Index:    idx,
					}
				}(hitCounter, currentCaptchaToken)
				hitCounter++
			}
		}

		go func() {
			wg.Wait()
			close(results)
		}()

		var lastResponse *APIResponse
		for res := range results {
			if res.Success {
				cancel()
				return res.Response, nil
			}
			if res.Response != nil {
				lastResponse = res.Response
			}
		}
		cancel()

		if lastResponse != nil && lastResponse.StatusCode == 400 && (strings.Contains(strings.ToLower(lastResponse.Message), "captcha") ||
			strings.Contains(strings.ToLower(lastResponse.Message), "verification") ||
			strings.Contains(strings.ToLower(lastResponse.Message), "expired") ||
			strings.Contains(strings.ToLower(lastResponse.Message), "invalid")) {

			if isReserveSlot {
				c.captchaQueue.InvalidateReserveToken(currentCaptchaToken)
				newToken, err := c.getFreshReserveCaptchaToken(true)
				if err == nil && newToken != "" {
					currentCaptchaToken = newToken
					continue
				}
			} else {
				c.captchaQueue.InvalidateLoginToken(currentCaptchaToken)
				newToken, err := c.getLoginCaptchaToken()
				if err == nil && newToken != "" {
					currentCaptchaToken = newToken
					continue
				}
			}
		}

		time.Sleep(2 * time.Second)
	}
}

// ==================== SINGLE HIT RETRY FUNCTIONS ====================

func (c *IVACClient) executeSingleRetryWithCaptchaReuse(apiUrl string, body interface{}, token string, endpointName string, initialCaptchaToken string, isReserveSlot bool) (*APIResponse, error) {
	for {
		select {
		case <-c.ctx.Done():
			return nil, errors.New("context cancelled")
		default:
		}

		proxyURL := getRandomProxyURL()
		requestURL := c.buildRequestURL(apiUrl)

		client := getHTTPClient(proxyURL)

		var reqBody io.Reader
		requestBody := body

		if isReserveSlot && initialCaptchaToken != "" {
			encryptedToken := encryptCaptchaForReserve(initialCaptchaToken)
			if requestBody == nil {
				requestBody = make(map[string]interface{})
			}
			if bodyMap, ok := requestBody.(map[string]interface{}); ok {
				bodyMap["c"] = encryptedToken
				requestBody = bodyMap
			}
		} else if !isReserveSlot && initialCaptchaToken != "" {
			if requestBody == nil {
				requestBody = make(map[string]interface{})
			}
			if bodyMap, ok := requestBody.(map[string]interface{}); ok {
				encryptedToken := encryptCaptchaForLogin(initialCaptchaToken)
				bodyMap["c"] = encryptedToken
				requestBody = bodyMap
			}
		}

		if requestBody != nil {
			jBytes, _ := json.Marshal(requestBody)
			reqBody = bytes.NewBuffer(jBytes)
		}

		req, err := http.NewRequest("POST", requestURL, reqBody)
		if err != nil {
			c.log(fmt.Sprintf("❌ Request creation error: %v", err))
			time.Sleep(1 * time.Second)
			continue
		}

		req.Host = "api.ivacbd.com"
		setRequestHeaders(req, c.deviceInfo, token)

		resp, err := client.Do(req)
		if err != nil {
			c.log(fmt.Sprintf("❌ Request error: %v", err))
			time.Sleep(1 * time.Second)
			c.rotateHostIP()
			continue
		}

		b, _ := io.ReadAll(resp.Body)
		resp.Body.Close()

		var apiResp APIResponse
		json.Unmarshal(b, &apiResp)
		apiResp.StatusCode = resp.StatusCode

		success := false
		if isReserveSlot {
			success = (apiResp.Status == "OK_NEW" || apiResp.Status == "RESERVED") && apiResp.Data != nil && apiResp.Data["reservationId"] != nil
		} else {
			success = (resp.StatusCode >= 200 && resp.StatusCode < 300) || apiResp.SuccessFlag
		}

		if success {
			c.log(fmt.Sprintf("✅ Single request succeeded for %s", endpointName))
			return &apiResp, nil
		}

		// Check if we need to refresh captcha
		if apiResp.StatusCode == 400 && (strings.Contains(strings.ToLower(apiResp.Message), "captcha") ||
			strings.Contains(strings.ToLower(apiResp.Message), "verification") ||
			strings.Contains(strings.ToLower(apiResp.Message), "expired") ||
			strings.Contains(strings.ToLower(apiResp.Message), "invalid")) {

			if isReserveSlot {
				c.captchaQueue.InvalidateReserveToken(initialCaptchaToken)
				newToken, err := c.getFreshReserveCaptchaToken(true)
				if err == nil && newToken != "" {
					initialCaptchaToken = newToken
					c.log("🔄 Captcha invalid/expired, got fresh token, retrying...")
					continue
				}
			} else {
				c.captchaQueue.InvalidateLoginToken(initialCaptchaToken)
				newToken, err := c.getLoginCaptchaToken()
				if err == nil && newToken != "" {
					initialCaptchaToken = newToken
					c.log("🔄 Captcha invalid/expired, got fresh token, retrying...")
					continue
				}
			}
		}

		c.log(fmt.Sprintf("⚠️ Single request failed for %s: %s, retrying...", endpointName, apiResp.Message))
		time.Sleep(2 * time.Second)
		c.rotateHostIP()
	}
}

func setRequestHeaders(req *http.Request, deviceInfo *DeviceInfo, token string) {
	for k, v := range browserHeaders {
		req.Header.Set(k, v)
	}
	if deviceInfo != nil && deviceInfo.DeviceID != "" {
		req.Header.Set("x-device-id", deviceInfo.DeviceID)
	}
	if token != "" {
		req.Header.Set("authorization", "Bearer "+token)
	}
}

func loadProxies() error {
	proxiesMu.Lock()
	defer proxiesMu.Unlock()
	data, err := os.ReadFile(PROXY_CONFIG_FILE)
	if err != nil {
		globalProxies = []ProxyConfig{}
		return saveProxiesFile()
	}
	return json.Unmarshal(data, &globalProxies)
}

func saveProxiesFile() error {
	data, _ := json.MarshalIndent(globalProxies, "", "  ")
	return os.WriteFile(PROXY_CONFIG_FILE, data, 0644)
}

func addProxy(proxy ProxyConfig) {
	proxiesMu.Lock()
	defer proxiesMu.Unlock()
	proxy.ID = fmt.Sprintf("%d", time.Now().UnixNano())
	proxy.CreatedAt = time.Now()
	globalProxies = append(globalProxies, proxy)
	saveProxiesFile()
}

func updateProxy(id string, proxy ProxyConfig) {
	proxiesMu.Lock()
	defer proxiesMu.Unlock()
	for i, p := range globalProxies {
		if p.ID == id {
			proxy.ID = id
			proxy.CreatedAt = p.CreatedAt
			globalProxies[i] = proxy
			break
		}
	}
	saveProxiesFile()
}

func deleteProxy(id string) {
	proxiesMu.Lock()
	defer proxiesMu.Unlock()
	for i, p := range globalProxies {
		if p.ID == id {
			globalProxies = append(globalProxies[:i], globalProxies[i+1:]...)
			break
		}
	}
	saveProxiesFile()
}

func getEnabledProxies() []ProxyConfig {
	proxiesMu.RLock()
	defer proxiesMu.RUnlock()
	var enabled []ProxyConfig
	for _, p := range globalProxies {
		if p.Enabled {
			enabled = append(enabled, p)
		}
	}
	return enabled
}

func getProxyURL(proxy ProxyConfig) string {
	if !proxy.Enabled {
		return ""
	}
	auth := ""
	if proxy.User != "" && proxy.Password != "" {
		auth = fmt.Sprintf("%s:%s@", proxy.User, proxy.Password)
	}
	return fmt.Sprintf("%s://%s%s:%d", proxy.Type, auth, proxy.Host, proxy.Port)
}

func detectProxyType(host string, port int) string {
	testURL := fmt.Sprintf("http://%s:%d", host, port)
	client := &http.Client{Timeout: 5 * time.Second}
	resp, err := client.Get(testURL)
	if err == nil && resp != nil {
		resp.Body.Close()
		return "http"
	}
	testURL = fmt.Sprintf("https://%s:%d", host, port)
	resp, err = client.Get(testURL)
	if err == nil && resp != nil {
		resp.Body.Close()
		return "https"
	}
	return "http"
}

func testProxy(proxy *ProxyConfig) bool {
	proxyURL := getProxyURL(*proxy)
	if proxyURL == "" {
		return false
	}
	start := time.Now()
	transport := &http.Transport{TLSClientConfig: &tls.Config{InsecureSkipVerify: true}}
	if parsedURL, err := url.Parse(proxyURL); err == nil {
		transport.Proxy = http.ProxyURL(parsedURL)
	}
	client := &http.Client{Timeout: 10 * time.Second, Transport: transport}
	resp, err := client.Get("https://api.ipify.org?format=json")
	if err != nil {
		proxy.TestPass = false
		proxy.ResponseMs = int(time.Since(start).Milliseconds())
		return false
	}
	defer resp.Body.Close()
	proxy.TestPass = resp.StatusCode == 200
	proxy.ResponseMs = int(time.Since(start).Milliseconds())
	proxy.LastTest = time.Now()
	return proxy.TestPass
}

func testAllProxies() {
	proxiesMu.Lock()
	defer proxiesMu.Unlock()
	for i := range globalProxies {
		testProxy(&globalProxies[i])
	}
	saveProxiesFile()
}

func getRandomProxyURL() string {
	proxies := getEnabledProxies()
	if len(proxies) == 0 {
		return ""
	}
	var workingProxies []ProxyConfig
	for _, p := range proxies {
		if p.TestPass {
			workingProxies = append(workingProxies, p)
		}
	}
	if len(workingProxies) > 0 {
		return getProxyURL(workingProxies[rand.Intn(len(workingProxies))])
	}
	return getProxyURL(proxies[rand.Intn(len(proxies))])
}

func getHTTPClient(proxyURL string) *http.Client {
	transport := &http.Transport{
		TLSClientConfig: &tls.Config{
			InsecureSkipVerify: true,
			ServerName:         "api.ivacbd.com",
		},
		MaxIdleConns:        100,
		IdleConnTimeout:     90 * time.Second,
		MaxIdleConnsPerHost: 100,
		ForceAttemptHTTP2:   true,
	}

	if proxyURL != "" && proxyURL != "none" {
		if p, e := url.Parse(proxyURL); e == nil {
			transport.Proxy = http.ProxyURL(p)
			if transport.DialContext == nil {
				transport.DialContext = (&net.Dialer{
					Timeout:   30 * time.Second,
					KeepAlive: 30 * time.Second,
				}).DialContext
			}
		}
	}

	return &http.Client{
		Timeout: 0,
		Transport: transport,
		CheckRedirect: func(req *http.Request, via []*http.Request) error {
			return http.ErrUseLastResponse
		},
	}
}

func websocketHandler(w http.ResponseWriter, r *http.Request) {
	conn, err := upgrader.Upgrade(w, r, nil)
	if err != nil {
		return
	}
	client := &wsClient{conn: conn, mu: sync.Mutex{}}
	wsClientsMu.Lock()
	wsClients[conn] = client
	wsClientsMu.Unlock()
	defer func() {
		wsClientsMu.Lock()
		delete(wsClients, conn)
		wsClientsMu.Unlock()
	}()
	client.mu.Lock()
	conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"connected","timestamp":"`+time.Now().Format(time.RFC3339)+`"}`))
	client.mu.Unlock()
	conn.SetPongHandler(func(string) error {
		conn.SetReadDeadline(time.Now().Add(60 * time.Second))
		return nil
	})
	ticker := time.NewTicker(30 * time.Second)
	defer ticker.Stop()
	go func() {
		for range ticker.C {
			wsClientsMu.RLock()
			_, exists := wsClients[conn]
			wsClientsMu.RUnlock()
			if !exists {
				return
			}
			client.mu.Lock()
			conn.WriteMessage(websocket.PingMessage, nil)
			client.mu.Unlock()
		}
	}()
	for {
		_, msg, err := conn.ReadMessage()
		if err != nil {
			break
		}
		client.mu.Lock()
		conn.WriteMessage(websocket.TextMessage, msg)
		client.mu.Unlock()
	}
}

func broadcastUpdate(update interface{}) {
	wsClientsMu.RLock()
	clients := make([]*wsClient, 0, len(wsClients))
	for _, client := range wsClients {
		clients = append(clients, client)
	}
	wsClientsMu.RUnlock()
	if len(clients) == 0 {
		return
	}
	data, _ := json.Marshal(update)
	for _, client := range clients {
		go func(c *wsClient) {
			c.mu.Lock()
			defer c.mu.Unlock()
			if err := c.conn.WriteMessage(websocket.TextMessage, data); err != nil {
				wsClientsMu.Lock()
				delete(wsClients, c.conn)
				wsClientsMu.Unlock()
				c.conn.Close()
			}
		}(client)
	}
}

func writeHostsEntry(ip string) error {
	if runtime.GOOS != "windows" {
		return fmt.Errorf("hosts file modification is only supported on Windows")
	}
	data, err := os.ReadFile(HOSTS_FILE)
	if err != nil {
		return fmt.Errorf("cannot read hosts file (Run as Administrator!): %v", err)
	}
	lines := strings.Split(string(data), "\n")
	var newLines []string
	found := false
	for _, line := range lines {
		trimmed := strings.TrimSpace(line)
		if strings.HasPrefix(trimmed, "#") || trimmed == "" {
			newLines = append(newLines, line)
			continue
		}
		if strings.Contains(trimmed, HOSTS_DOMAIN) {
			newLines = append(newLines, ip+" "+HOSTS_DOMAIN)
			found = true
		} else {
			newLines = append(newLines, line)
		}
	}
	if !found {
		newLines = append(newLines, "", ip+" "+HOSTS_DOMAIN)
	}
	if err := os.WriteFile(HOSTS_FILE, []byte(strings.Join(newLines, "\n")), 0644); err != nil {
		return fmt.Errorf("failed to write hosts file (Run as Administrator): %v", err)
	}
	exec.Command("cmd", "/C", "ipconfig", "/flushdns").Run()
	return nil
}

func removeHostsEntry() error {
	if runtime.GOOS != "windows" {
		return nil
	}
	data, err := os.ReadFile(HOSTS_FILE)
	if err != nil {
		return err
	}
	lines := strings.Split(string(data), "\n")
	var newLines []string
	for _, line := range lines {
		trimmed := strings.TrimSpace(line)
		if strings.Contains(trimmed, HOSTS_DOMAIN) && !strings.HasPrefix(trimmed, "#") {
			continue
		}
		newLines = append(newLines, line)
	}
	if err := os.WriteFile(HOSTS_FILE, []byte(strings.Join(newLines, "\n")), 0644); err != nil {
		return err
	}
	exec.Command("cmd", "/C", "ipconfig", "/flushdns").Run()
	return nil
}

type HostStats struct {
	IP           string        `json:"ip"`
	SuccessCount int           `json:"successCount"`
	FailedCount  int           `json:"failedCount"`
	LastUsed     time.Time     `json:"lastUsed"`
	ResponseTime time.Duration `json:"responseTime"`
	IsHealthy    bool          `json:"isHealthy"`
	SuccessRate  float64       `json:"successRate"`
}

type HostRouter struct {
	mu             sync.RWMutex
	hostIPs        []string
	stats          map[string]*HostStats
	bestHostIP     string
	minSuccessRate float64
	roundRobinIdx  int
}

var globalHostRouter *HostRouter
var hostRouterOnce sync.Once

func GetHostRouter() *HostRouter {
	hostRouterOnce.Do(func() {
		configMu.RLock()
		hostIPs := make([]string, len(globalConfig.HostIPs))
		copy(hostIPs, globalConfig.HostIPs)
		configMu.RUnlock()
		globalHostRouter = &HostRouter{
			hostIPs:        hostIPs,
			stats:          make(map[string]*HostStats),
			bestHostIP:     "",
			minSuccessRate: 0.7,
			roundRobinIdx:  0,
		}
		for _, ip := range hostIPs {
			globalHostRouter.stats[ip] = &HostStats{
				IP:           ip,
				SuccessCount: 0,
				FailedCount:  0,
				IsHealthy:    true,
				SuccessRate:  0,
			}
		}
	})
	return globalHostRouter
}

func (hr *HostRouter) UpdateHostIPs(ips []string) {
	hr.mu.Lock()
	defer hr.mu.Unlock()
	hr.hostIPs = ips
	for _, ip := range ips {
		if _, exists := hr.stats[ip]; !exists {
			hr.stats[ip] = &HostStats{
				IP:           ip,
				SuccessCount: 0,
				FailedCount:  0,
				IsHealthy:    true,
				SuccessRate:  0,
			}
		}
	}
	for ip := range hr.stats {
		found := false
		for _, hip := range ips {
			if hip == ip {
				found = true
				break
			}
		}
		if !found && ip != hr.bestHostIP {
			delete(hr.stats, ip)
		}
	}
	if hr.bestHostIP != "" {
		found := false
		for _, hip := range ips {
			if hip == hr.bestHostIP {
				found = true
				break
			}
		}
		if !found {
			hr.bestHostIP = ""
		}
	}
}

func (hr *HostRouter) GetInstanceHostIP(instanceID int) string {
	hr.mu.Lock()
	defer hr.mu.Unlock()
	if len(hr.hostIPs) == 0 {
		return ""
	}
	idx := instanceID % len(hr.hostIPs)
	return hr.hostIPs[idx]
}

func (hr *HostRouter) GetRandomHostIP() string {
	hr.mu.RLock()
	defer hr.mu.RUnlock()
	if len(hr.hostIPs) == 0 {
		return ""
	}
	if hr.bestHostIP != "" {
		return hr.bestHostIP
	}
	idx := rand.Intn(len(hr.hostIPs))
	return hr.hostIPs[idx]
}

func (hr *HostRouter) GetRandomDifferentHostIP(currentIP string) string {
	hr.mu.RLock()
	defer hr.mu.RUnlock()
	if len(hr.hostIPs) == 0 {
		return ""
	}
	if len(hr.hostIPs) == 1 {
		return hr.hostIPs[0]
	}
	var availableIPs []string
	for _, ip := range hr.hostIPs {
		if ip != currentIP {
			availableIPs = append(availableIPs, ip)
		}
	}
	if len(availableIPs) == 0 {
		availableIPs = hr.hostIPs
	}
	idx := rand.Intn(len(availableIPs))
	return availableIPs[idx]
}

func (hr *HostRouter) GetBestHostIP() string {
	hr.mu.RLock()
	defer hr.mu.RUnlock()
	return hr.bestHostIP
}

func (hr *HostRouter) RecordResult(ip string, success bool, responseTime time.Duration) {
	hr.mu.Lock()
	defer hr.mu.Unlock()
	stats, exists := hr.stats[ip]
	if !exists {
		stats = &HostStats{IP: ip, SuccessCount: 0, FailedCount: 0, IsHealthy: true}
		hr.stats[ip] = stats
	}
	stats.LastUsed = time.Now()
	if success {
		stats.SuccessCount++
		stats.ResponseTime = responseTime
	} else {
		stats.FailedCount++
	}
	total := stats.SuccessCount + stats.FailedCount
	if total > 0 {
		stats.SuccessRate = float64(stats.SuccessCount) / float64(total)
		if total > 5 {
			stats.IsHealthy = stats.SuccessRate >= hr.minSuccessRate
		}
	}
	hr.evaluateBestHost()
}

func (hr *HostRouter) evaluateBestHost() {
	if len(hr.hostIPs) == 0 {
		return
	}
	var bestIP string
	var bestScore float64
	for ip, stats := range hr.stats {
		total := stats.SuccessCount + stats.FailedCount
		if total < 3 {
			continue
		}
		successRate := float64(stats.SuccessCount) / float64(total)
		score := successRate
		if stats.ResponseTime < time.Second {
			score += 0.1
		}
		if score > bestScore && successRate >= hr.minSuccessRate {
			bestScore = score
			bestIP = ip
		}
	}
	if bestIP != "" && bestIP != hr.bestHostIP {
		hr.bestHostIP = bestIP
	}
}

func (hr *HostRouter) ResetBestHost() {
	hr.mu.Lock()
	defer hr.mu.Unlock()
	hr.bestHostIP = ""
}

func (hr *HostRouter) GetAllHostStats() []HostStats {
	hr.mu.RLock()
	defer hr.mu.RUnlock()
	stats := make([]HostStats, 0, len(hr.stats))
	for _, s := range hr.stats {
		stats = append(stats, *s)
	}
	return stats
}

func (c *IVACClient) buildRequestURL(apiURL string) string {
	if c.currentHostIP == "" || c.config.HostIPs == nil || len(c.config.HostIPs) == 0 {
		return apiURL
	}

	parsedURL, err := url.Parse(apiURL)
	if err != nil {
		return apiURL
	}

	scheme := "https"
	if parsedURL.Scheme == "http" {
		scheme = "http"
	}

	newURL := fmt.Sprintf("%s://%s%s", scheme, c.currentHostIP, parsedURL.Path)
	if parsedURL.RawQuery != "" {
		newURL = newURL + "?" + parsedURL.RawQuery
	}

	return newURL
}

func (c *IVACClient) getLoginCaptchaToken() (string, error) {
	if !c.config.AutoCaptcha {
		c.log("⚠️ Auto captcha is disabled in config")
		return "", errors.New("auto captcha disabled")
	}

	if c.config.CaptchaAPIKey == "" {
		c.log("❌ Captcha API key is empty! Please add your API key in Config tab")
		return "", errors.New("captcha API key is empty")
	}

	c.log(fmt.Sprintf("🔑 Getting login captcha token from queue (Service: %s)", c.config.CaptchaService))

	token, err := c.captchaQueue.GetLoginToken()
	if err == nil && token != "" {
		c.log(fmt.Sprintf("✅ Got login token from queue (length: %d)", len(token)))
		return token, nil
	}

	c.log("⚠️ Login queue empty, solving captcha directly...")
	return c.solveCaptchaDirect("Solving captcha directly for login...")
}

func (c *IVACClient) getReserveCaptchaToken() (string, error) {
	if !c.config.AutoCaptcha {
		c.log("⚠️ Auto captcha is disabled in config")
		return "", errors.New("auto captcha disabled")
	}

	if c.config.CaptchaAPIKey == "" {
		c.log("❌ Captcha API key is empty! Please add your API key in Config tab")
		return "", errors.New("captcha API key is empty")
	}

	c.log(fmt.Sprintf("🔑 Getting reserve captcha token from queue (Service: %s)", c.config.CaptchaService))

	token, err := c.captchaQueue.GetReserveToken()
	if err == nil && token != "" {
		c.log(fmt.Sprintf("✅ Got reserve token from queue (length: %d)", len(token)))
		return token, nil
	}

	c.log("⚠️ Reserve queue empty, solving captcha directly...")
	return c.solveCaptchaDirect("Solving captcha directly for reserve slot...")
}

func (c *IVACClient) getFreshReserveCaptchaToken(forceRefresh bool) (string, error) {
	if !c.config.AutoCaptcha {
		return "", errors.New("auto captcha disabled")
	}
	if forceRefresh {
		return c.solveCaptchaDirect("Getting fresh reserve captcha token...")
	}
	return c.getReserveCaptchaToken()
}

func (c *IVACClient) solveCaptchaDirect(logMsg string) (string, error) {
	c.log(logMsg)

	if c.config.CaptchaAPIKey == "" {
		c.log("❌ Captcha API key is empty! Please configure it in Config tab")
		return "", errors.New("captcha API key is empty")
	}

	c.log(fmt.Sprintf("🔧 Using captcha service: %s", c.config.CaptchaService))

	for attempt := 1; attempt <= 5; attempt++ {
		if attempt > 1 {
			c.log(fmt.Sprintf("🔄 Retry attempt %d/5 after 5 seconds...", attempt))
			time.Sleep(5 * time.Second)
		}

		proxyURL := getRandomProxyURL()
		client := getHTTPClient(proxyURL)

		var token string
		var err error

		switch c.config.CaptchaService {
		case CAPTCHA_SERVICE_CAPMONSTER:
			c.log("🤖 Solving with CapMonster...")
			token, err = c.solveCapMonsterDirect(client)
		case CAPTCHA_SERVICE_2CAPTCHA:
			c.log("🤖 Solving with 2Captcha...")
			token, err = c.solve2CaptchaDirect(client)
		default:
			c.log("🤖 Solving with Capsolver...")
			token, err = c.solveCapSolverDirect(client)
		}

		if err == nil && token != "" {
			c.log(fmt.Sprintf("✅ Captcha solved successfully! Token length: %d", len(token)))
			return token, nil
		}

		c.log(fmt.Sprintf("❌ Attempt %d failed: %v", attempt, err))
	}

	return "", errors.New("captcha failed after 5 attempts")
}

func (c *IVACClient) solveCapSolverDirect(client *http.Client) (string, error) {
	if c.config.CaptchaAPIKey == "" {
		return "", errors.New("capsolver API key is empty")
	}

	taskData := map[string]interface{}{
		"clientKey": c.config.CaptchaAPIKey,
		"task": map[string]interface{}{
			"type":       "AntiTurnstileTaskProxyless",
			"websiteURL": WEBSITE_URL,
			"websiteKey": TURNSTILE_SITE_KEY,
		},
	}

	jsonData, _ := json.Marshal(taskData)
	c.log("📤 Creating Capsolver task...")

	resp, err := client.Post("https://api.capsolver.com/createTask", "application/json", bytes.NewBuffer(jsonData))
	if err != nil {
		return "", fmt.Errorf("capsolver createTask error: %v", err)
	}
	defer resp.Body.Close()

	body, _ := io.ReadAll(resp.Body)
	var res map[string]interface{}
	json.Unmarshal(body, &res)

	if errId, ok := res["errorId"]; ok && errId.(float64) > 0 {
		errDesc := ""
		if desc, ok := res["errorDescription"].(string); ok {
			errDesc = desc
		}
		return "", fmt.Errorf("capsolver error: %s", errDesc)
	}

	taskId, ok := res["taskId"]
	if !ok {
		return "", errors.New("no taskId returned from capsolver")
	}

	c.log(fmt.Sprintf("📝 Capsolver task ID: %v", taskId))

	for attempt := 0; attempt < 30; attempt++ {
		time.Sleep(3 * time.Second)

		resultData := map[string]interface{}{
			"clientKey": c.config.CaptchaAPIKey,
			"taskId":    taskId,
		}
		jsonResult, _ := json.Marshal(resultData)

		resp2, err := client.Post("https://api.capsolver.com/getTaskResult", "application/json", bytes.NewBuffer(jsonResult))
		if err != nil {
			continue
		}

		body2, _ := io.ReadAll(resp2.Body)
		resp2.Body.Close()

		var tr map[string]interface{}
		json.Unmarshal(body2, &tr)

		if status, ok := tr["status"].(string); ok && status == "ready" {
			if solution, ok := tr["solution"].(map[string]interface{}); ok {
				if token, ok := solution["token"].(string); ok && token != "" {
					return token, nil
				}
			}
		}

		if status, _ := tr["status"].(string); status == "failed" {
			return "", errors.New("capsolver task failed")
		}
	}

	return "", errors.New("capsolver timeout after 90 seconds")
}

func (c *IVACClient) solveCapMonsterDirect(client *http.Client) (string, error) {
	if c.config.CaptchaAPIKey == "" {
		return "", errors.New("capmonster API key is empty")
	}

	task := map[string]interface{}{
		"clientKey": c.config.CaptchaAPIKey,
		"task": map[string]interface{}{
			"type":       "TurnstileTaskProxyless",
			"websiteURL": WEBSITE_URL,
			"websiteKey": TURNSTILE_SITE_KEY,
		},
	}

	jsonData, _ := json.Marshal(task)
	c.log("📤 Creating CapMonster task...")

	resp, err := client.Post("https://api.capmonster.cloud/createTask", "application/json", bytes.NewBuffer(jsonData))
	if err != nil {
		return "", fmt.Errorf("capmonster createTask error: %v", err)
	}
	defer resp.Body.Close()

	body, _ := io.ReadAll(resp.Body)
	var res map[string]interface{}
	json.Unmarshal(body, &res)

	if eid, ok := res["errorId"].(float64); ok && eid > 0 {
		errDesc, _ := res["errorDescription"].(string)
		return "", fmt.Errorf("capmonster error: %s", errDesc)
	}

	tid, ok := res["taskId"].(float64)
	if !ok {
		return "", errors.New("no taskId returned from capmonster")
	}

	c.log(fmt.Sprintf("📝 CapMonster task ID: %.0f", tid))

	for attempt := 0; attempt < 30; attempt++ {
		time.Sleep(2 * time.Second)

		getTask := map[string]interface{}{
			"clientKey": c.config.CaptchaAPIKey,
			"taskId":    fmt.Sprintf("%.0f", tid),
		}
		jsonGet, _ := json.Marshal(getTask)

		resp2, err := client.Post("https://api.capmonster.cloud/getTaskResult", "application/json", bytes.NewBuffer(jsonGet))
		if err != nil {
			continue
		}

		body2, _ := io.ReadAll(resp2.Body)
		resp2.Body.Close()

		var tr map[string]interface{}
		json.Unmarshal(body2, &tr)

		if s, ok := tr["status"].(string); ok && s == "ready" {
			if sol, ok := tr["solution"].(map[string]interface{}); ok {
				if tok, ok := sol["token"].(string); ok && tok != "" {
					return tok, nil
				}
			}
		}

		if s, _ := tr["status"].(string); s == "failed" {
			return "", errors.New("capmonster task failed")
		}
	}

	return "", errors.New("capmonster timeout after 60 seconds")
}

func (c *IVACClient) solve2CaptchaDirect(client *http.Client) (string, error) {
	if c.config.CaptchaAPIKey == "" {
		return "", errors.New("2captcha API key is empty")
	}

	submitURL := fmt.Sprintf("https://2captcha.com/in.php?key=%s&method=turnstile&sitekey=%s&pageurl=%s&json=1",
		c.config.CaptchaAPIKey, TURNSTILE_SITE_KEY, WEBSITE_URL)

	c.log("📤 Submitting to 2Captcha...")

	resp, err := client.Get(submitURL)
	if err != nil {
		return "", fmt.Errorf("2captcha submit error: %v", err)
	}
	defer resp.Body.Close()

	body, _ := io.ReadAll(resp.Body)
	var submitRes map[string]interface{}
	json.Unmarshal(body, &submitRes)

	if status, ok := submitRes["status"].(float64); !ok || status != 1 {
		errMsg := ""
		if req, ok := submitRes["request"].(string); ok {
			errMsg = req
		}
		return "", fmt.Errorf("2captcha submit error: %s", errMsg)
	}

	taskId, ok := submitRes["request"].(string)
	if !ok {
		return "", errors.New("no taskId returned from 2captcha")
	}

	c.log(fmt.Sprintf("📝 2Captcha task ID: %s", taskId))

	for attempt := 0; attempt < 60; attempt++ {
		time.Sleep(3 * time.Second)

		resultURL := fmt.Sprintf("https://2captcha.com/res.php?key=%s&action=get&id=%s&json=1",
			c.config.CaptchaAPIKey, taskId)

		resp2, err := client.Get(resultURL)
		if err != nil {
			continue
		}

		body2, _ := io.ReadAll(resp2.Body)
		resp2.Body.Close()

		var resultData map[string]interface{}
		json.Unmarshal(body2, &resultData)

		if status, ok := resultData["status"].(float64); ok && status == 1 {
			if token, ok := resultData["request"].(string); ok && token != "" {
				return token, nil
			}
		}

		if req, ok := resultData["request"].(string); ok && req == "ERROR_CAPTCHA_UNSOLVABLE" {
			return "", errors.New("captcha unsolvable")
		}
	}

	return "", errors.New("2captcha timeout after 180 seconds")
}

func getOTPUsingCurl(phone string) (string, error) {
	cleanPhone := regexp.MustCompile(`[^0-9]`).ReplaceAllString(phone, "")
	u := fmt.Sprintf("%s?action=get_latest_otp&mobile_no=%s", OTP_API_URL, cleanPhone)
	cmd := exec.Command("powershell", "-Command", fmt.Sprintf(`try { $response = Invoke-WebRequest -Uri '%s' -UseBasicParsing -TimeoutSec 10; $response.Content } catch { Write-Host "ERROR" }`, u))
	output, err := cmd.Output()
	if err == nil {
		result := strings.TrimSpace(string(output))
		if !strings.Contains(result, "ERROR") && result != "" {
			type smsResponse struct {
				Status string `json:"status"`
				OTP    string `json:"otp"`
			}
			var smsResp smsResponse
			if err := json.Unmarshal([]byte(result), &smsResp); err == nil {
				if smsResp.Status == "success" && smsResp.OTP != "" {
					return smsResp.OTP, nil
				}
			}
			pattern := regexp.MustCompile(`\d{5,6}`)
			matches := pattern.FindAllString(result, -1)
			if len(matches) > 0 {
				return matches[len(matches)-1], nil
			}
		}
	}
	client := &http.Client{Timeout: 30 * time.Second}
	resp, err := client.Get(u)
	if err != nil {
		return "", err
	}
	defer resp.Body.Close()
	body, _ := io.ReadAll(resp.Body)
	result := string(body)
	type smsResponse struct {
		Status string `json:"status"`
		OTP    string `json:"otp"`
	}
	var smsResp smsResponse
	if err := json.Unmarshal(body, &smsResp); err == nil {
		if smsResp.Status == "success" && smsResp.OTP != "" {
			return smsResp.OTP, nil
		}
	}
	pattern := regexp.MustCompile(`\d{5,6}`)
	matches := pattern.FindAllString(result, -1)
	if len(matches) > 0 {
		return matches[len(matches)-1], nil
	}
	return "", fmt.Errorf("no OTP found")
}

type APIResponse struct {
	SuccessFlag bool                   `json:"successFlag"`
	Message     string                 `json:"message"`
	Data        map[string]interface{} `json:"data"`
	Status      string                 `json:"status"`
	StatusCode  int                    `json:"statusCode"`
	RequestID   string                 `json:"requestId"`
}

func loadConfig() error {
	configMu.Lock()
	defer configMu.Unlock()
	globalConfig = Config{
		CaptchaAPIKey:        "",
		CaptchaService:       CAPTCHA_SERVICE_CAPSOLVER,
		QueueSize:            3,
		ReserveQueueSize:     2,
		LoginCaptchaExpiry:   DEFAULT_LOGIN_CAPTCHA_EXPIRY,
		ReserveCaptchaExpiry: DEFAULT_RESERVE_CAPTCHA_EXPIRY,
		HostIPs:              []string{},
		LoginMode:            "auto",
		AutoCaptcha:          true,
		AutoOTP:              true,
		OTPRetryDelay:        5000,
		SlotMonitor:          SlotMonitorConfig{Enabled: false},
		SlotCheckInterval:    15,
		RequestMode:          REQUEST_MODE_SINGLE,
		Parallel: ParallelConfig{
			SigninHits: 15, SigninMs: 300,
			VerifyHits: 25, VerifyMs: 500,
			ReserveHits: 10, ReserveMs: 1000,
			BookingHits: 10, BookingMs: 500,
			InitiateHits: 2, InitiateMs: 100,
		},
		ParallelRetry: ParallelRetryConfig{
			Signin:  ParallelRetryItem{Enabled: false, Hits: []int{3, 2, 5, 4}, DelayMs: 100, ReuseCaptcha: true},
			Verify:  ParallelRetryItem{Enabled: false, Hits: []int{3, 2, 5, 4}, DelayMs: 100, ReuseCaptcha: false},
			Reserve: ParallelRetryItem{Enabled: false, Hits: []int{3, 2, 5, 4}, DelayMs: 100, ReuseCaptcha: true},
			Booking: ParallelRetryItem{Enabled: false, Hits: []int{3, 2, 5, 4}, DelayMs: 100, ReuseCaptcha: false},
			Payment: ParallelRetryItem{Enabled: false, Hits: []int{3, 2, 5, 4}, DelayMs: 100, ReuseCaptcha: false},
		},
	}
	data, err := os.ReadFile(CONFIG_FILE)
	if err != nil {
		return saveConfigFile()
	}
	return json.Unmarshal(data, &globalConfig)
}

func saveConfigFile() error {
	data, _ := json.MarshalIndent(globalConfig, "", "  ")
	return os.WriteFile(CONFIG_FILE, data, 0644)
}

func saveConfig() {
	configMu.RLock()
	defer configMu.RUnlock()
	saveConfigFile()
}

func loadInstances() error {
	data, err := os.ReadFile(INSTANCES_FILE)
	if err != nil {
		return nil
	}
	var list []InstanceData
	if err := json.Unmarshal(data, &list); err != nil {
		return err
	}
	instancesMu.Lock()
	defer instancesMu.Unlock()
	for _, d := range list {
		if d.NetworkLogs == nil {
			d.NetworkLogs = []NetworkRequest{}
		}
		if d.Logs == nil {
			d.Logs = []string{}
		}
		instances[d.ID] = &Instance{Data: d}
		if int32(d.ID) >= instanceID {
			instanceID = int32(d.ID) + 1
		}
	}
	return nil
}

func saveInstancesToFile() {
	instancesMu.RLock()
	var list []InstanceData
	for _, inst := range instances {
		inst.mu.Lock()
		list = append(list, inst.Data)
		inst.mu.Unlock()
	}
	instancesMu.RUnlock()
	data, _ := json.MarshalIndent(list, "", "  ")
	os.WriteFile(INSTANCES_FILE, data, 0644)
}

type IVACClient struct {
	session          *Session
	captchaQueue     *SilentCaptchaQueue
	proxies          []string
	config           *Config
	logCb            func(string)
	stepCb           func(string, string, string, string, string)
	networkCb        func(NetworkRequest)
	instanceID       int
	currentProxy     string
	currentHostIP    string
	pooledClient     *http.Client
	deviceInfo       *DeviceInfo
	hasAppointmentID bool
	lastEndpoint     string
	ctx              context.Context
	cancel           context.CancelFunc
	successTracker   *EndpointSuccessTracker
}

type Session struct {
	Token      string
	RequestID  string
	LoginPhone string
	OTPPhone   string
	UserID     string
}

func NewIVACClient(cfg *Config, proxies []string, instanceID int, deviceInfo *DeviceInfo, hasAppointmentID bool, logCb func(string), stepCb func(string, string, string, string, string), networkCb func(NetworkRequest)) *IVACClient {
	ctx, cancel := context.WithCancel(context.Background())
	return &IVACClient{
		session:          &Session{},
		captchaQueue:     NewSilentCaptchaQueue(cfg.CaptchaAPIKey, cfg.CaptchaService, cfg.QueueSize, cfg.ReserveQueueSize, cfg.LoginCaptchaExpiry, cfg.ReserveCaptchaExpiry, logCb),
		proxies:          proxies,
		config:           cfg,
		logCb:            logCb,
		stepCb:           stepCb,
		networkCb:        networkCb,
		instanceID:       instanceID,
		pooledClient:     getHTTPClient(""),
		deviceInfo:       deviceInfo,
		hasAppointmentID: hasAppointmentID,
		ctx:              ctx,
		cancel:           cancel,
		successTracker:   NewEndpointSuccessTracker(),
	}
}

func (c *IVACClient) log(msg string) {
	if c.logCb != nil {
		c.logCb(msg)
	}
}

func (c *IVACClient) setStep(step, otp, rid, appointmentDate, payUrl string) {
	if c.stepCb != nil {
		c.stepCb(step, otp, rid, appointmentDate, payUrl)
	}
}

func (c *IVACClient) Login(loginPhone, password string) error {
	c.log(fmt.Sprintf("🔐 Logging in: %s", loginPhone))
	c.setStep("LOGGING_IN", "", "", "", "")

	for {
		token, err := c.getLoginCaptchaToken()
		if err != nil {
			c.log(fmt.Sprintf("❌ Failed to get captcha: %v", err))
			time.Sleep(2 * time.Second)
			c.rotateHostIP()
			continue
		}

		encryptedToken := encryptCaptchaForLogin(token)

		req := map[string]interface{}{
			"phone":    loginPhone,
			"password": password,
			"c":        encryptedToken,
		}

		var resp *APIResponse
		var err2 error

		if c.shouldUseParallelMode() {
			parallelRetryConfig := c.getCurrentParallelRetryConfig()
			if parallelRetryConfig.Signin.Enabled {
				resp, err2 = c.executeParallelRetryWithCaptchaReuse(
					API_LOGIN_URL, req, "", "Login API",
					parallelRetryConfig.Signin,
					token, false,
				)
			} else {
				resp, err2 = c.executeParallelRetryWithCaptchaReuse(
					API_LOGIN_URL, req, "", "Login API",
					ParallelRetryItem{Enabled: true, Hits: []int{c.getCurrentParallelConfig().SigninHits}, DelayMs: c.getCurrentParallelConfig().SigninMs, ReuseCaptcha: true},
					token, false,
				)
			}
		} else {
			resp, err2 = c.executeSingleRetryWithCaptchaReuse(
				API_LOGIN_URL, req, "", "Login API",
				token, false,
			)
		}

		if err2 != nil {
			c.log(fmt.Sprintf("❌ Login request failed: %v", err2))
			time.Sleep(2 * time.Second)
			c.rotateHostIP()
			continue
		}

		if resp.Data != nil {
			if accessToken, ok := resp.Data["accessToken"].(string); ok {
				c.session.Token = accessToken
				c.session.LoginPhone = loginPhone
				if reqId, ok := resp.Data["requestId"].(string); ok {
					c.session.RequestID = reqId
				} else if resp.RequestID != "" {
					c.session.RequestID = resp.RequestID
				}
				if userId, ok := resp.Data["userId"].(string); ok {
					c.session.UserID = userId
				}
				c.log("✅ Login successful!")
				c.setStep("LOGGED_IN", "", "", "", "")
				return nil
			}
			if msg, ok := resp.Data["message"].(string); ok && strings.Contains(msg, "Captcha") {
				c.log("❌ Captcha invalid, retrying...")
				c.captchaQueue.InvalidateLoginToken(token)
			}
		}
		time.Sleep(2 * time.Second)
		c.rotateHostIP()
	}
}

func (c *IVACClient) GetOTPWithManual(phone string, instanceID int) (string, error) {
	c.log(fmt.Sprintf("📱 Waiting for OTP for: %s", phone))
	c.log("💡 You can type OTP manually in the dashboard input field")
	c.setStep("WAITING_OTP", "", "", "", "")
	broadcastUpdate(map[string]interface{}{
		"type":       "waiting_otp",
		"instanceId": instanceID,
		"phone":      phone,
	})
	ticker := time.NewTicker(1 * time.Second)
	defer ticker.Stop()
	autoTicker := time.NewTicker(3 * time.Second)
	defer autoTicker.Stop()
	for {
		select {
		case <-c.ctx.Done():
			return "", errors.New("context cancelled")
		case <-ticker.C:
			instancesMu.RLock()
			inst, ok := instances[instanceID]
			instancesMu.RUnlock()
			if ok {
				inst.mu.Lock()
				manualOTP := inst.Data.ManualOTP
				if manualOTP != "" && len(manualOTP) == 6 {
					inst.Data.ManualOTP = ""
					inst.mu.Unlock()
					c.log(fmt.Sprintf("✅ Manual OTP received: %s", manualOTP))
					c.setStep("OTP_RECEIVED", manualOTP, "", "", "")
					return manualOTP, nil
				}
				inst.mu.Unlock()
			}
		case <-autoTicker.C:
			if c.config.AutoOTP {
				otp, err := getOTPUsingCurl(phone)
				if err == nil && otp != "" && len(otp) == 6 {
					c.log(fmt.Sprintf("✅ Auto OTP received: %s", otp))
					c.setStep("OTP_RECEIVED", otp, "", "", "")
					return otp, nil
				}
			}
		}
	}
}

func (c *IVACClient) VerifyOTP(phone, otpCode string) error {
	c.log("🔐 Verifying OTP...")
	c.setStep("VERIFYING_OTP", otpCode, "", "", "")
	req := map[string]interface{}{
		"requestId":  c.session.RequestID,
		"phone":      phone,
		"code":       otpCode,
		"email":      "",
		"otpChannel": "PHONE",
	}
	for {
		var resp *APIResponse
		var err error

		if c.shouldUseParallelMode() {
			parallelRetryConfig := c.getCurrentParallelRetryConfig()
			if parallelRetryConfig.Verify.Enabled {
				resp, err = c.executeParallelRetryWithCaptchaReuse(
					API_VERIFY_OTP_URL, req, c.session.Token, "Verify OTP API",
					parallelRetryConfig.Verify,
					"", false,
				)
			} else {
				resp, err = c.executeParallelRetryWithCaptchaReuse(
					API_VERIFY_OTP_URL, req, c.session.Token, "Verify OTP API",
					ParallelRetryItem{Enabled: true, Hits: []int{c.getCurrentParallelConfig().VerifyHits}, DelayMs: c.getCurrentParallelConfig().VerifyMs, ReuseCaptcha: false},
					"", false,
				)
			}
		} else {
			resp, err = c.executeSingleRetryWithCaptchaReuse(
				API_VERIFY_OTP_URL, req, c.session.Token, "Verify OTP API",
				"", false,
			)
		}
		
		if resp != nil && strings.Contains(strings.ToLower(resp.Message), "invalid") {
			newOTP, err := c.GetOTPWithManual(phone, c.instanceID)
			if err == nil && newOTP != "" && newOTP != otpCode {
				otpCode = newOTP
				req["code"] = newOTP
				c.setStep("VERIFYING_OTP", newOTP, "", "", "")
				continue
			}
		}
		if err == nil && (resp.SuccessFlag || resp.StatusCode == 200) {
			c.log("✅ OTP verified!")
			c.setStep("OTP_VERIFIED", otpCode, "", "", "")
			return nil
		}
		time.Sleep(time.Duration(c.config.OTPRetryDelay) * time.Millisecond)
	}
}

func (c *IVACClient) GetBookingConfig() (string, error) {
	c.log("📋 Getting booking configuration...")
	c.setStep("BOOKING_CONFIG_LOADING", "", "", "", "")

	for {
		var resp *APIResponse
		var err error

		if c.shouldUseParallelMode() {
			parallelRetryConfig := c.getCurrentParallelRetryConfig()
			if parallelRetryConfig.Booking.Enabled {
				resp, err = c.executeParallelRetryWithCaptchaReuse(
					API_BOOKING_CONFIG, nil, c.session.Token, "Booking Config API",
					parallelRetryConfig.Booking,
					"", false,
				)
			} else {
				resp, err = c.executeParallelRetryWithCaptchaReuse(
					API_BOOKING_CONFIG, nil, c.session.Token, "Booking Config API",
					ParallelRetryItem{Enabled: true, Hits: []int{c.getCurrentParallelConfig().BookingHits}, DelayMs: c.getCurrentParallelConfig().BookingMs, ReuseCaptcha: false},
					"", false,
				)
			}
		} else {
			resp, err = c.executeSingleRetryWithCaptchaReuse(
				API_BOOKING_CONFIG, nil, c.session.Token, "Booking Config API",
				"", false,
			)
		}

		if err != nil {
			time.Sleep(2 * time.Second)
			continue
		}

		if resp.SuccessFlag && resp.Data != nil {
			if id, ok := resp.Data["appointmentId"].(string); ok && id != "" {
				c.log(fmt.Sprintf("✅ Booking config loaded - Appointment ID: %s", id))
				c.setStep("BOOKING_CONFIG_LOADED", "", "", "", "")
				return id, nil
			}
		}
		time.Sleep(2 * time.Second)
	}
}

func (c *IVACClient) InitiatePayment(appointmentId string) (string, error) {
	c.log(fmt.Sprintf("💳 Initiating payment with dg-epay using Appointment ID: %s", appointmentId))
	c.setStep("INITIATING_PAYMENT", "", "", "", "")
	reqBody := map[string]interface{}{"appointmentId": appointmentId}
	if appointmentId == "" {
		reqBody = nil
	}
	for {
		var resp *APIResponse
		var err error

		if c.shouldUseParallelMode() {
			parallelRetryConfig := c.getCurrentParallelRetryConfig()
			if parallelRetryConfig.Payment.Enabled {
				resp, err = c.executeParallelRetryWithCaptchaReuse(
					API_PAYMENT_URL, reqBody, c.session.Token, "Payment API",
					parallelRetryConfig.Payment,
					"", false,
				)
			} else {
				resp, err = c.executeParallelRetryWithCaptchaReuse(
					API_PAYMENT_URL, reqBody, c.session.Token, "Payment API",
					ParallelRetryItem{Enabled: true, Hits: []int{c.getCurrentParallelConfig().InitiateHits}, DelayMs: c.getCurrentParallelConfig().InitiateMs, ReuseCaptcha: false},
					"", false,
				)
			}
		} else {
			resp, err = c.executeSingleRetryWithCaptchaReuse(
				API_PAYMENT_URL, reqBody, c.session.Token, "Payment API",
				"", false,
			)
		}
		
		if err != nil {
			time.Sleep(2 * time.Second)
			continue
		}
		if resp.SuccessFlag && resp.Data != nil {
			var paymentURL string
			if webviewURL, ok := resp.Data["webview_url"].(string); ok && webviewURL != "" {
				paymentURL = webviewURL
				c.log("✅ Payment URL generated via dg-epay!")
			} else if gatewayURL, ok := resp.Data["GatewayPageURL"].(string); ok && gatewayURL != "" {
				paymentURL = gatewayURL
				c.log("✅ Payment URL generated!")
			}
			
			if paymentURL != "" {
				c.setStep("PAYMENT_READY", "", "", "", paymentURL)
				broadcastUpdate(map[string]interface{}{
					"type":       "payment_url",
					"instanceId": c.instanceID,
					"paymentUrl": paymentURL,
				})
				return paymentURL, nil
			}
		}
		time.Sleep(2 * time.Second)
	}
}

func (c *IVACClient) CheckSlotStatus() (bool, error) {
	c.log("🔍 Checking slot status...")
	resp, err := c.doRequest("slot-status", "Slot Status API", nil, c.session.Token)
	if err != nil {
		return false, err
	}
	if resp.StatusCode == 401 {
		return false, fmt.Errorf("unauthorized: token expired (401)")
	}
	if resp.StatusCode == 200 && resp.SuccessFlag && resp.Data != nil {
		if slotOpen, ok := resp.Data["slotOpen"].(bool); ok {
			return slotOpen, nil
		}
		if available, ok := resp.Data["available"].(bool); ok {
			return available, nil
		}
	}
	return false, nil
}

func (c *IVACClient) startSlotMonitoringAndReserve() (string, string, error) {
	c.log("🔍 Starting slot monitoring...")
	c.setStep("MONITORING_SLOTS", "", "", "", "")
	if !c.config.SlotMonitor.Enabled {
		return c.reserveSlotWithRetry()
	}
	checkInterval := c.config.SlotCheckInterval
	if checkInterval == 0 {
		checkInterval = 15
	}
	for {
		select {
		case <-c.ctx.Done():
			return "", "", nil
		default:
		}
		slotAvailable, err := c.CheckSlotStatus()
		if err != nil {
			if strings.Contains(err.Error(), "rate_limited") {
				continue
			}
			time.Sleep(time.Duration(checkInterval) * time.Second)
			continue
		}
		if slotAvailable {
			c.log("✅ Slot is OPEN! Proceeding to reserve...")
			time.Sleep(2 * time.Second)
			return c.reserveSlotWithRetry()
		} else {
			time.Sleep(time.Duration(checkInterval) * time.Second)
		}
	}
}

func (c *IVACClient) reserveSlotWithRetry() (string, string, error) {
	c.log("📌 Reserving slot with OFFICIAL RESERVE encryption...")
	c.setStep("RESERVING_SLOT", "", "", "", "")

	var reservationID, appointmentDate string
	initialToken, err := c.getReserveCaptchaToken()
	if err != nil {
		return "", "", fmt.Errorf("failed to get initial captcha token: %v", err)
	}

	for {
		var resp *APIResponse
		var err2 error

		encryptedToken := encryptCaptchaForReserve(initialToken)
		req := map[string]interface{}{"c": encryptedToken}

		if c.shouldUseParallelMode() {
			parallelRetryConfig := c.getCurrentParallelRetryConfig()
			if parallelRetryConfig.Reserve.Enabled {
				resp, err2 = c.executeParallelRetryWithCaptchaReuse(
					API_RESERVE_SLOT_URL, req, c.session.Token, "Reserve Slot API",
					parallelRetryConfig.Reserve,
					initialToken, true,
				)
			} else {
				resp, err2 = c.executeParallelRetryWithCaptchaReuse(
					API_RESERVE_SLOT_URL, req, c.session.Token, "Reserve Slot API",
					ParallelRetryItem{Enabled: true, Hits: []int{c.getCurrentParallelConfig().ReserveHits}, DelayMs: c.getCurrentParallelConfig().ReserveMs, ReuseCaptcha: true},
					initialToken, true,
				)
			}
		} else {
			resp, err2 = c.executeSingleRetryWithCaptchaReuse(
				API_RESERVE_SLOT_URL, req, c.session.Token, "Reserve Slot API",
				initialToken, true,
			)
		}

		if err2 != nil {
			time.Sleep(2 * time.Second)
			continue
		}

		if resp.Data != nil {
			if id, ok := resp.Data["reservationId"].(string); ok && id != "" {
				reservationID = id
				c.log(fmt.Sprintf("✅ Got Reservation ID: %s", reservationID))

				if date, ok := resp.Data["appointmentDate"].(string); ok {
					appointmentDate = date
					c.log(fmt.Sprintf("✅ Got Appointment Date: %s", appointmentDate))
				}

				if ttl, ok := resp.Data["reserveTtlSeconds"].(float64); ok {
					c.log(fmt.Sprintf("   Time to complete payment: %d seconds (%d minutes)", int(ttl), int(ttl)/60))
				}

				c.log(fmt.Sprintf("✅ Slot reserved successfully! ID: %s, Date: %s", reservationID, appointmentDate))
				c.setStep("SLOT_RESERVED", "", reservationID, appointmentDate, "")
				return reservationID, appointmentDate, nil
			}
		}

		if resp.StatusCode == 400 && (strings.Contains(strings.ToLower(resp.Message), "captcha") ||
			strings.Contains(strings.ToLower(resp.Message), "verification") ||
			strings.Contains(strings.ToLower(resp.Message), "expired") ||
			strings.Contains(strings.ToLower(resp.Message), "invalid")) {
			c.captchaQueue.InvalidateReserveToken(initialToken)
			freshToken, freshErr := c.solveCaptchaDirect("Getting fresh captcha token...")
			if freshErr == nil && freshToken != "" {
				initialToken = freshToken
			}
		}

		time.Sleep(2 * time.Second)
	}
}

func (c *IVACClient) RunFullFlow(loginPhone, password, otpPhone string, savedAppointmentID string, doneCb func(string, string)) {
	start := time.Now()
	c.log("🚀 Starting flow...")
	hasAppointmentID := savedAppointmentID != ""

	if hasAppointmentID {
		c.log(fmt.Sprintf("📌 Using saved Appointment ID: %s", savedAppointmentID))
	} else {
		c.log("📌 No saved Appointment ID found")
	}

	// Step 1: Login
	if err := c.Login(loginPhone, password); err != nil {
		c.setStep("FAILED", "", "", "", "")
		doneCb("FAILED", err.Error())
		return
	}

	// Step 2: Get OTP
	otp, err := c.GetOTPWithManual(otpPhone, c.instanceID)
	if err != nil {
		c.setStep("FAILED", "", "", "", "")
		doneCb("FAILED", "OTP failed")
		return
	}

	// Step 3: Verify OTP
	if err := c.VerifyOTP(otpPhone, otp); err != nil {
		c.setStep("FAILED", "", "", "", "")
		doneCb("FAILED", "Verify failed")
		return
	}

	// Step 4: Reserve slot (ALWAYS do this first)
	reservationID, appointmentDate, err := c.startSlotMonitoringAndReserve()
	if err != nil {
		c.log(fmt.Sprintf("❌ Slot reservation failed: %v", err))
		c.setStep("FAILED", "", "", "", "")
		doneCb("FAILED", err.Error())
		return
	}

	c.log(fmt.Sprintf("✅ Reservation successful! ID: %s, Date: %s", reservationID, appointmentDate))

	var finalAppointmentID string

	// Step 5: Determine payment flow based on saved Appointment ID
	if hasAppointmentID {
		finalAppointmentID = savedAppointmentID
		c.log(fmt.Sprintf("📌 Using saved Appointment ID: %s", finalAppointmentID))
	} else {
		c.log("📌 No saved Appointment ID, fetching booking config...")
		finalAppointmentID, err = c.GetBookingConfig()
		if err != nil {
			c.log(fmt.Sprintf("⚠️ Failed to get booking config: %v, but slot is reserved!", err))
			c.setStep("SLOT_RESERVED", "", reservationID, appointmentDate, "")
			doneCb("SLOT_RESERVED", fmt.Sprintf("Slot reserved! ID: %s, Date: %s (Payment config failed)", reservationID, appointmentDate))
			return
		}
		c.log(fmt.Sprintf("✅ Got Appointment ID: %s", finalAppointmentID))
	}

	// Step 6: Initiate Payment
	payUrl, err := c.InitiatePayment(finalAppointmentID)
	if err != nil {
		c.log(fmt.Sprintf("⚠️ Payment initiation failed: %v, but slot is reserved!", err))
		c.setStep("SLOT_RESERVED", "", reservationID, appointmentDate, "")
		doneCb("SLOT_RESERVED", fmt.Sprintf("Slot reserved! ID: %s, Date: %s (Payment failed)", reservationID, appointmentDate))
		return
	}

	c.log(fmt.Sprintf("✨ Completed in %s", time.Since(start)))
	c.log(fmt.Sprintf("🎉 Final - Reservation ID: %s, Payment URL: %s", reservationID, payUrl))
	c.setStep("COMPLETED", "", reservationID, appointmentDate, payUrl)
	doneCb("COMPLETED", "Success")
}

func (c *IVACClient) Cleanup() {
	if c.captchaQueue != nil {
		c.captchaQueue.Stop()
	}
	if c.cancel != nil {
		c.cancel()
	}
}

func (c *IVACClient) rotateHostIP() {
	hostRouter := GetHostRouter()
	newHostIP := hostRouter.GetRandomDifferentHostIP(c.currentHostIP)
	if newHostIP != "" && newHostIP != c.currentHostIP {
		c.currentHostIP = newHostIP
		if inst, ok := c.getInstance(); ok {
			inst.mu.Lock()
			inst.Data.CurrentHostIP = newHostIP
			inst.mu.Unlock()
		}
	}
}

func (c *IVACClient) getInstance() (*Instance, bool) {
	instancesMu.RLock()
	defer instancesMu.RUnlock()
	inst, ok := instances[c.instanceID]
	return inst, ok
}

func (c *IVACClient) isLoginSuccess(resp *APIResponse) bool {
	return resp.SuccessFlag && resp.StatusCode == 200 && resp.Data != nil && resp.Data["accessToken"] != nil && resp.Message == "Success"
}

func (c *IVACClient) isVerifySuccess(resp *APIResponse) bool {
	return resp.SuccessFlag && resp.StatusCode == 200 && resp.Message == "Success" && resp.Data != nil
}

func (c *IVACClient) isReserveSuccess(resp *APIResponse) bool {
	return (resp.Status == "OK_NEW" || resp.Status == "RESERVED") && resp.Data != nil && resp.Data["reservationId"] != nil
}

func (c *IVACClient) isBookingConfigSuccess(resp *APIResponse) bool {
	return resp.SuccessFlag && resp.StatusCode == 200 && resp.Message == "Success" && resp.Data != nil && resp.Data["appointmentId"] != nil
}

func (c *IVACClient) isPaymentSuccess(resp *APIResponse) bool {
	return resp.SuccessFlag && resp.StatusCode == 201 && resp.Message == "Initiated" && resp.Data != nil && (resp.Data["webview_url"] != nil || resp.Data["GatewayPageURL"] != nil)
}

func (c *IVACClient) doRequestWithUnlimitedRetry(endpointKey, endpointDisplay string, body interface{}, token string, successChecker func(*APIResponse) bool) (*APIResponse, error) {
	endpointMutex := c.successTracker.GetMutex(endpointKey)
	endpointMutex.Lock()
	defer endpointMutex.Unlock()

	if c.successTracker.IsSuccess(endpointKey) {
		return nil, errors.New("already succeeded")
	}

	for {
		select {
		case <-c.ctx.Done():
			return nil, errors.New("context cancelled")
		default:
		}

		if c.successTracker.IsSuccess(endpointKey) {
			return nil, errors.New("already succeeded")
		}

		reqCtx, reqCancel := context.WithCancel(c.ctx)
		c.successTracker.RegisterCancel(endpointKey, reqCancel)

		if c.successTracker.IsSuccess(endpointKey) {
			reqCancel()
			return nil, errors.New("already succeeded")
		}

		resp, err := c.doRequestWithContext(reqCtx, endpointKey, endpointDisplay, body, token)

		if err != nil {
			if errors.Is(err, context.Canceled) {
				return nil, errors.New("cancelled by success")
			}
			time.Sleep(2 * time.Second)
			c.rotateHostIP()
			continue
		}

		if successChecker(resp) {
			c.successTracker.MarkSuccess(endpointKey)
			return resp, nil
		}

		time.Sleep(2 * time.Second)
		c.rotateHostIP()
	}
}

func (c *IVACClient) doRequest(endpointKey, endpointDisplay string, body interface{}, token string) (*APIResponse, error) {
	ctx, cancel := context.WithCancel(c.ctx)
	defer cancel()
	c.successTracker.RegisterCancel(endpointKey, cancel)
	if c.successTracker.IsSuccess(endpointKey) {
		return nil, errors.New("already succeeded")
	}
	return c.doRequestWithContext(ctx, endpointKey, endpointDisplay, body, token)
}

func (c *IVACClient) doRequestWithContext(ctx context.Context, endpointKey, endpointDisplay string, body interface{}, token string) (*APIResponse, error) {
	hostRouter := GetHostRouter()
	if c.currentHostIP == "" {
		c.currentHostIP = hostRouter.GetRandomHostIP()
	}

	var apiURL string
	switch endpointKey {
	case "sign-in-v2", "Login API":
		apiURL = API_LOGIN_URL
	case "verifySigninOtp", "Verify OTP API":
		apiURL = API_VERIFY_OTP_URL
	case "reserveSlot", "Reserve Slot API":
		apiURL = API_RESERVE_SLOT_URL
	case "get-booking-config", "Get Booking API":
		apiURL = API_BOOKING_CONFIG
	case "initiate", "Payment API":
		apiURL = API_PAYMENT_URL
	case "slot-status", "Slot Status API":
		apiURL = API_SLOT_STATUS_URL
	default:
		apiURL = API_LOGIN_URL
	}

	requestURL := c.buildRequestURL(apiURL)

	proxyURL := getRandomProxyURL()
	client := getHTTPClient(proxyURL)

	var r io.Reader
	if body != nil {
		j, _ := json.Marshal(body)
		r = bytes.NewBuffer(j)
	}

	var req *http.Request
	var reqErr error
	if body != nil {
		req, reqErr = http.NewRequestWithContext(ctx, "POST", requestURL, r)
	} else {
		req, reqErr = http.NewRequestWithContext(ctx, "GET", requestURL, nil)
	}
	if reqErr != nil {
		return nil, reqErr
	}

	req.Host = "api.ivacbd.com"
	setRequestHeaders(req, c.deviceInfo, token)

	start := time.Now()
	resp, err := client.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()

	duration := time.Since(start)
	b, _ := io.ReadAll(resp.Body)
	var result APIResponse
	json.Unmarshal(b, &result)
	result.StatusCode = resp.StatusCode

	if c.currentHostIP != "" {
		hostRouter.RecordResult(c.currentHostIP, resp.StatusCode >= 200 && resp.StatusCode < 300, duration)
	}

	proxyIP := "none"
	if proxyURL != "" {
		if pURL, err := url.Parse(proxyURL); err == nil {
			proxyIP = pURL.Hostname()
		}
	}

	clientIP := c.currentHostIP
	if clientIP == "" {
		clientIP = "api.ivacbd.com"
	}

	if c.networkCb != nil {
		statusText := "Success"
		if resp.StatusCode >= 400 {
			statusText = result.Message
			if statusText == "" {
				statusText = http.StatusText(resp.StatusCode)
			}
		}
		netReq := NetworkRequest{
			Endpoint:   endpointDisplay,
			Method:     "POST",
			StatusCode: resp.StatusCode,
			StatusText: statusText,
			ClientIP:   clientIP,
			ProxyIP:    proxyIP,
			HostIP:     c.currentHostIP,
			Timestamp:  time.Now(),
			Duration:   duration.String(),
			RequestID:  result.RequestID,
			RespBody:   string(b)[:min(200, len(string(b)))],
		}
		c.networkCb(netReq)
	}

	return &result, nil
}

func addInstance(clientName, loginPhone, password, otpPhone, typ, highCom, visaType, loginMode string) int {
	id := int(atomic.AddInt32(&instanceID, 1) - 1)
	displayType := typ
	if highCom != "" && visaType != "" && typ == "" {
		displayType = highCom + " - " + visaType
	}
	hostRouter := GetHostRouter()
	assignedHostIP := hostRouter.GetInstanceHostIP(id)
	deviceGen := GetDeviceGenerator()
	deviceInfo := deviceGen.GenerateDeviceInfo(id)
	instancesMu.Lock()
	instances[id] = &Instance{
		Data: InstanceData{
			ID: id, ClientName: clientName, LoginPhone: loginPhone, Password: password,
			OTPPhone: otpPhone, Type: displayType, HighCom: highCom, VisaType: visaType,
			Name: loginPhone, Status: "STOPPED", Step: "READY",
			Logs: make([]string, 0), NetworkLogs: make([]NetworkRequest, 0),
			AssignedHostIP: assignedHostIP, CurrentHostIP: assignedHostIP,
			RetryCount: 0, DeviceInfo: deviceInfo, AppointmentID: "",
			HasAppointmentID: false, PausedStep: "",
		},
	}
	instancesMu.Unlock()
	saveInstancesToFile()
	return id
}

func addLog(id int, msg string) {
	instancesMu.RLock()
	inst, ok := instances[id]
	instancesMu.RUnlock()
	if ok {
		inst.mu.Lock()
		inst.Data.Logs = append(inst.Data.Logs, fmt.Sprintf("[%s] %s", time.Now().Format("15:04:05"), msg))
		if len(inst.Data.Logs) > 500 {
			inst.Data.Logs = inst.Data.Logs[len(inst.Data.Logs)-500:]
		}
		inst.mu.Unlock()
	}
}

func addNetworkLog(id int, req NetworkRequest) {
	instancesMu.RLock()
	inst, ok := instances[id]
	instancesMu.RUnlock()
	if ok {
		inst.mu.Lock()
		inst.Data.NetworkLogs = append([]NetworkRequest{req}, inst.Data.NetworkLogs...)
		if len(inst.Data.NetworkLogs) > 50 {
			inst.Data.NetworkLogs = inst.Data.NetworkLogs[:50]
		}
		inst.mu.Unlock()
	}
}

func runInstanceFlow(ctx context.Context, inst *Instance, id int) {
	configMu.RLock()
	cfg := globalConfig
	configMu.RUnlock()

	stepCb := func(step, otp, rid, appointmentDate, payUrl string) {
		inst.mu.Lock()
		if inst.Data.Status != "STOPPED" && inst.Data.Status != "PAUSED" {
			inst.Data.Step = step
		}
		if otp != "" {
			inst.Data.OTP = otp
		}
		if rid != "" {
			inst.Data.ReservationID = rid
			addLog(id, fmt.Sprintf("📌 Updated Reservation ID: %s", rid))
		}
		if appointmentDate != "" {
			inst.Data.AppointmentDate = appointmentDate
		}
		if payUrl != "" {
			inst.Data.PaymentURL = payUrl
			broadcastUpdate(map[string]interface{}{
				"type": "payment_url", "instanceId": id, "paymentUrl": payUrl, "step": step,
			})
		}
		inst.mu.Unlock()
	}

	networkCb := func(req NetworkRequest) { addNetworkLog(id, req) }

	inst.mu.Lock()
	deviceInfo := inst.Data.DeviceInfo
	savedAppointmentID := inst.Data.AppointmentID
	hasAppointmentID := savedAppointmentID != ""
	pausedStep := inst.Data.PausedStep
	inst.mu.Unlock()

	client := NewIVACClient(&cfg, nil, id, deviceInfo, hasAppointmentID,
		func(msg string) { addLog(id, msg) }, stepCb, networkCb)

	inst.mu.Lock()
	client.currentHostIP = inst.Data.CurrentHostIP
	inst.client = client
	inst.mu.Unlock()

	if pausedStep != "" {
		inst.mu.Lock()
		inst.Data.PausedStep = ""
		inst.mu.Unlock()
		addLog(id, fmt.Sprintf("▶️ Resuming from saved state"))
	}

	done := make(chan bool)
	go func() {
		client.RunFullFlow(inst.Data.LoginPhone, inst.Data.Password, inst.Data.OTPPhone, savedAppointmentID, func(status, message string) {
			inst.mu.Lock()
			if inst.Data.Status != "STOPPED" && inst.Data.Status != "PAUSED" {
				inst.Data.Status = status
			}
			if status == "COMPLETED" {
				inst.Data.Duration = time.Since(inst.Data.StartTime).String()
			}
			inst.mu.Unlock()
			done <- true
		})
	}()

	select {
	case <-done:
		client.Cleanup()
		saveInstancesToFile()
	case <-ctx.Done():
		inst.mu.Lock()
		if inst.Data.Status != "STOPPED" && inst.Data.Status != "PAUSED" {
			inst.Data.Status = "STOPPED"
			inst.Data.Step = "STOPPED"
		}
		inst.mu.Unlock()
		saveInstancesToFile()
		client.Cleanup()
	}
}

// ==================== HTTP HANDLERS ====================

func getInstances(w http.ResponseWriter, r *http.Request) {
	instancesMu.RLock()
	defer instancesMu.RUnlock()
	configMu.RLock()
	slotMonitorEnabled := globalConfig.SlotMonitor.Enabled
	configMu.RUnlock()
	var running, failed, completed int
	list := make([]map[string]interface{}, 0)
	for _, inst := range instances {
		inst.mu.Lock()
		s := inst.Data.Status
		if s == "RUNNING" {
			running++
		} else if s == "FAILED" {
			failed++
		} else if s == "COMPLETED" {
			completed++
		}
		lastLog := ""
		if len(inst.Data.Logs) > 0 {
			lastLog = inst.Data.Logs[len(inst.Data.Logs)-1]
			if len(lastLog) > 60 {
				lastLog = lastLog[:60] + "..."
			}
		}
		var latestNetwork *NetworkRequest
		if len(inst.Data.NetworkLogs) > 0 {
			latestNetwork = &inst.Data.NetworkLogs[0]
		}
		deviceIDShort := ""
		if inst.Data.DeviceInfo != nil && inst.Data.DeviceInfo.DeviceID != "" {
			deviceIDShort = inst.Data.DeviceInfo.DeviceID[:min(8, len(inst.Data.DeviceInfo.DeviceID))]
		}
		instanceMap := map[string]interface{}{
			"id": inst.Data.ID, "clientName": inst.Data.ClientName, "loginPhone": inst.Data.LoginPhone,
			"password": inst.Data.Password, "otpPhone": inst.Data.OTPPhone, "type": inst.Data.Type,
			"highCom": inst.Data.HighCom, "visaType": inst.Data.VisaType, "name": inst.Data.Name,
			"status": s, "step": inst.Data.Step, "otp": inst.Data.OTP,
			"reservationId": inst.Data.ReservationID, "appointmentDate": inst.Data.AppointmentDate,
			"paymentUrl": inst.Data.PaymentURL, "appointmentId": inst.Data.AppointmentID,
			"lastLog": lastLog, "duration": inst.Data.Duration, "assignedHostIP": inst.Data.AssignedHostIP,
			"currentHostIP": inst.Data.CurrentHostIP, "retryCount": inst.Data.RetryCount,
			"deviceId": deviceIDShort, "endpoint": func() string {
				if latestNetwork != nil {
					return latestNetwork.Endpoint
				}
				return "-"
			}(), "statusCode": func() int {
				if latestNetwork != nil {
					return latestNetwork.StatusCode
				}
				return 0
			}(), "statusText": func() string {
				if latestNetwork != nil {
					return latestNetwork.StatusText
				}
				return "-"
			}(), "clientIp": func() string {
				if latestNetwork != nil {
					return latestNetwork.ClientIP
				}
				return "-"
			}(), "proxyIp": func() string {
				if latestNetwork != nil && latestNetwork.ProxyIP != "" {
					return latestNetwork.ProxyIP
				}
				return "-"
			}(), "requestId": func() string {
				if latestNetwork != nil && latestNetwork.RequestID != "" {
					return latestNetwork.RequestID
				}
				return ""
			}(),
		}
		list = append(list, instanceMap)
		inst.mu.Unlock()
	}
	json.NewEncoder(w).Encode(map[string]interface{}{
		"total": len(instances), "running": running, "failed": failed, "completed": completed,
		"instances": list, "slotMonitorEnabled": slotMonitorEnabled,
	})
}

func startInstanceHandler(w http.ResponseWriter, r *http.Request) {
	var id int
	fmt.Sscanf(r.URL.Query().Get("id"), "%d", &id)
	instancesMu.RLock()
	inst, ok := instances[id]
	instancesMu.RUnlock()
	if !ok {
		w.WriteHeader(404)
		json.NewEncoder(w).Encode(map[string]string{"status": "not found"})
		return
	}
	inst.mu.Lock()
	if inst.Data.Status == "RUNNING" {
		inst.mu.Unlock()
		json.NewEncoder(w).Encode(map[string]string{"status": "already running"})
		return
	}
	inst.Data.Status = "RUNNING"
	inst.Data.StartTime = time.Now()
	inst.Data.Step = "STARTING"
	inst.Data.OTP = ""
	inst.Data.ReservationID = ""
	inst.Data.AppointmentDate = ""
	inst.Data.PaymentURL = ""
	inst.Data.NetworkLogs = make([]NetworkRequest, 0)
	inst.Data.RetryCount = 0
	inst.Data.ManualOTP = ""
	inst.Data.PausedStep = ""
	inst.mu.Unlock()
	ctx, cancel := context.WithCancel(context.Background())
	inst.mu.Lock()
	inst.cancel = cancel
	inst.mu.Unlock()
	go runInstanceFlow(ctx, inst, id)
	json.NewEncoder(w).Encode(map[string]string{"status": "started"})
}

func stopInstanceHandler(w http.ResponseWriter, r *http.Request) {
	var id int
	fmt.Sscanf(r.URL.Query().Get("id"), "%d", &id)
	instancesMu.RLock()
	inst, ok := instances[id]
	instancesMu.RUnlock()
	if !ok {
		w.WriteHeader(404)
		return
	}
	go func() {
		inst.mu.Lock()
		if inst.cancel != nil {
			inst.cancel()
		}
		inst.Data.Status = "STOPPED"
		inst.Data.Step = "STOPPED"
		inst.Data.PausedStep = ""
		inst.mu.Unlock()
		saveInstancesToFile()
	}()
	json.NewEncoder(w).Encode(map[string]string{"status": "stopped"})
}

func deleteInstanceHandler(w http.ResponseWriter, r *http.Request) {
	var id int
	fmt.Sscanf(r.URL.Query().Get("id"), "%d", &id)
	go func() {
		instancesMu.Lock()
		if inst, ok := instances[id]; ok {
			inst.mu.Lock()
			if inst.cancel != nil {
				inst.cancel()
			}
			inst.mu.Unlock()
			delete(instances, id)
		}
		instancesMu.Unlock()
		saveInstancesToFile()
	}()
	json.NewEncoder(w).Encode(map[string]string{"status": "deleted"})
}

func addInstanceHandler(w http.ResponseWriter, r *http.Request) {
	if r.Method != "POST" {
		w.WriteHeader(405)
		return
	}
	var req struct {
		ClientName string `json:"clientName"`
		LoginPhone string `json:"loginPhone"`
		Password   string `json:"password"`
		OTPPhone   string `json:"otpPhone"`
		Type       string `json:"type"`
		HighCom    string `json:"highCom"`
		VisaType   string `json:"visaType"`
	}
	json.NewDecoder(r.Body).Decode(&req)
	highCom := req.HighCom
	visaType := req.VisaType
	if highCom == "" {
		highCom = "DHAKA"
	}
	if visaType == "" {
		visaType = "MEDICAL"
	}
	configMu.RLock()
	loginMode := globalConfig.LoginMode
	configMu.RUnlock()
	id := addInstance(req.ClientName, req.LoginPhone, req.Password, req.OTPPhone, req.Type, highCom, visaType, loginMode)
	json.NewEncoder(w).Encode(map[string]int{"id": id})
}

func updateInstanceHandler(w http.ResponseWriter, r *http.Request) {
	if r.Method != "POST" {
		w.WriteHeader(405)
		return
	}
	var req struct {
		ID         int    `json:"id"`
		ClientName string `json:"clientName"`
		LoginPhone string `json:"loginPhone"`
		Password   string `json:"password"`
		OTPPhone   string `json:"otpPhone"`
		Type       string `json:"type"`
		HighCom    string `json:"highCom"`
		VisaType   string `json:"visaType"`
	}
	json.NewDecoder(r.Body).Decode(&req)
	instancesMu.RLock()
	inst, ok := instances[req.ID]
	instancesMu.RUnlock()
	if !ok {
		w.WriteHeader(404)
		json.NewEncoder(w).Encode(map[string]string{"status": "not found"})
		return
	}
	inst.mu.Lock()
	inst.Data.ClientName = req.ClientName
	inst.Data.LoginPhone = req.LoginPhone
	inst.Data.Password = req.Password
	inst.Data.OTPPhone = req.OTPPhone
	inst.Data.Name = req.LoginPhone
	if req.HighCom != "" && req.VisaType != "" {
		inst.Data.Type = req.HighCom + " - " + req.VisaType
		inst.Data.HighCom = req.HighCom
		inst.Data.VisaType = req.VisaType
	} else if req.Type != "" {
		inst.Data.Type = req.Type
	}
	inst.mu.Unlock()
	saveInstancesToFile()
	json.NewEncoder(w).Encode(map[string]string{"status": "updated"})
}

func toggleAllHandler(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Action string `json:"action"`
	}
	json.NewDecoder(r.Body).Decode(&req)
	switch req.Action {
	case "start":
		go func() {
			instancesMu.RLock()
			all := make([]*Instance, 0, len(instances))
			for _, inst := range instances {
				all = append(all, inst)
			}
			instancesMu.RUnlock()
			for _, inst := range all {
				inst.mu.Lock()
				if inst.Data.Status != "RUNNING" && inst.Data.Status != "COMPLETED" && inst.Data.Status != "PAUSED" {
					inst.Data.Status = "RUNNING"
					inst.Data.StartTime = time.Now()
					inst.Data.Step = "STARTING"
					inst.Data.OTP = ""
					inst.Data.ReservationID = ""
					inst.Data.AppointmentDate = ""
					inst.Data.PaymentURL = ""
					inst.Data.NetworkLogs = make([]NetworkRequest, 0)
					inst.Data.RetryCount = 0
					inst.Data.ManualOTP = ""
					inst.Data.PausedStep = ""
					inst.mu.Unlock()
					ctx, cancel := context.WithCancel(context.Background())
					inst.mu.Lock()
					inst.cancel = cancel
					inst.mu.Unlock()
					go runInstanceFlow(ctx, inst, inst.Data.ID)
				} else {
					inst.mu.Unlock()
				}
			}
			saveInstancesToFile()
		}()
		json.NewEncoder(w).Encode(map[string]string{"status": "started all"})
	case "stop":
		go func() {
			instancesMu.RLock()
			all := make([]*Instance, 0, len(instances))
			for _, inst := range instances {
				all = append(all, inst)
			}
			instancesMu.RUnlock()
			for _, inst := range all {
				inst.mu.Lock()
				if inst.cancel != nil {
					inst.cancel()
				}
				inst.Data.Status = "STOPPED"
				inst.Data.Step = "STOPPED"
				inst.Data.PausedStep = ""
				inst.mu.Unlock()
			}
			saveInstancesToFile()
		}()
		json.NewEncoder(w).Encode(map[string]string{"status": "stopped all"})
	case "pause":
		go func() {
			instancesMu.RLock()
			all := make([]*Instance, 0, len(instances))
			for _, inst := range instances {
				all = append(all, inst)
			}
			instancesMu.RUnlock()
			for _, inst := range all {
				inst.mu.Lock()
				if inst.cancel != nil && inst.Data.Status == "RUNNING" {
					inst.cancel()
					inst.Data.Status = "PAUSED"
					inst.Data.Step = "PAUSED"
					inst.Data.PausedStep = inst.Data.Step
				}
				inst.mu.Unlock()
			}
			saveInstancesToFile()
		}()
		json.NewEncoder(w).Encode(map[string]string{"status": "paused all"})
	case "resume":
		go func() {
			instancesMu.RLock()
			all := make([]*Instance, 0, len(instances))
			for _, inst := range instances {
				all = append(all, inst)
			}
			instancesMu.RUnlock()
			for _, inst := range all {
				inst.mu.Lock()
				if inst.Data.Status == "PAUSED" {
					inst.Data.Status = "RUNNING"
					inst.Data.StartTime = time.Now()
					inst.Data.Step = "RESUMING"
					inst.Data.ManualOTP = ""
					inst.mu.Unlock()
					ctx, cancel := context.WithCancel(context.Background())
					inst.mu.Lock()
					inst.cancel = cancel
					inst.mu.Unlock()
					go runInstanceFlow(ctx, inst, inst.Data.ID)
				} else {
					inst.mu.Unlock()
				}
			}
			saveInstancesToFile()
		}()
		json.NewEncoder(w).Encode(map[string]string{"status": "resumed all"})
	}
}

func handleConfig(w http.ResponseWriter, r *http.Request) {
	if r.Method == "GET" {
		configMu.RLock()
		defer configMu.RUnlock()
		json.NewEncoder(w).Encode(globalConfig)
	} else if r.Method == "POST" {
		var nc Config
		json.NewDecoder(r.Body).Decode(&nc)
		configMu.Lock()
		globalConfig = nc
		configMu.Unlock()
		saveConfig()
		if len(nc.HostIPs) > 0 {
			GetHostRouter().UpdateHostIPs(nc.HostIPs)
		}
		if nc.SlotMonitor.Enabled {
			startSlotMonitor()
		} else {
			stopSlotMonitor()
		}
		json.NewEncoder(w).Encode(map[string]string{"status": "saved"})
	}
}

func handleParallelConfig(w http.ResponseWriter, r *http.Request) {
	if r.Method == "GET" {
		configMu.RLock()
		defer configMu.RUnlock()
		json.NewEncoder(w).Encode(map[string]interface{}{
			"traditional":   globalConfig.Parallel,
			"parallelRetry": globalConfig.ParallelRetry,
		})
	} else if r.Method == "POST" {
		var req struct {
			Traditional   ParallelConfig       `json:"traditional"`
			ParallelRetry ParallelRetryConfig `json:"parallelRetry"`
		}
		json.NewDecoder(r.Body).Decode(&req)
		configMu.Lock()
		if req.Traditional.SigninHits > 0 {
			globalConfig.Parallel = req.Traditional
		}
		globalConfig.ParallelRetry = req.ParallelRetry
		configMu.Unlock()
		saveConfig()
		json.NewEncoder(w).Encode(map[string]string{"status": "saved"})
	}
}

func handleSlotMonitor(w http.ResponseWriter, r *http.Request) {
	if r.Method == "POST" {
		var req struct {
			Enabled bool `json:"enabled"`
		}
		json.NewDecoder(r.Body).Decode(&req)
		configMu.Lock()
		globalConfig.SlotMonitor.Enabled = req.Enabled
		configMu.Unlock()
		saveConfig()
		if req.Enabled {
			startSlotMonitor()
		} else {
			stopSlotMonitor()
		}
		json.NewEncoder(w).Encode(map[string]interface{}{"status": "ok", "enabled": req.Enabled})
	} else {
		configMu.RLock()
		enabled := globalConfig.SlotMonitor.Enabled
		configMu.RUnlock()
		json.NewEncoder(w).Encode(map[string]bool{"enabled": enabled})
	}
}

func handleGetLogs(w http.ResponseWriter, r *http.Request) {
	idStr := r.URL.Query().Get("id")
	var id int
	fmt.Sscanf(idStr, "%d", &id)
	instancesMu.RLock()
	inst, ok := instances[id]
	instancesMu.RUnlock()
	if !ok {
		w.WriteHeader(404)
		json.NewEncoder(w).Encode(map[string]string{"error": "instance not found"})
		return
	}
	inst.mu.Lock()
	defer inst.mu.Unlock()
	json.NewEncoder(w).Encode(map[string]interface{}{
		"logs":        inst.Data.Logs,
		"networkLogs": inst.Data.NetworkLogs,
	})
}

func handleClearLogs(w http.ResponseWriter, r *http.Request) {
	idStr := r.URL.Query().Get("id")
	var id int
	fmt.Sscanf(idStr, "%d", &id)
	instancesMu.RLock()
	inst, ok := instances[id]
	instancesMu.RUnlock()
	if !ok {
		w.WriteHeader(404)
		json.NewEncoder(w).Encode(map[string]string{"error": "instance not found"})
		return
	}
	inst.mu.Lock()
	inst.Data.Logs = make([]string, 0)
	inst.Data.NetworkLogs = make([]NetworkRequest, 0)
	inst.mu.Unlock()
	json.NewEncoder(w).Encode(map[string]string{"status": "cleared"})
}

func handleProxies(w http.ResponseWriter, r *http.Request) {
	if r.Method == "GET" {
		proxiesMu.RLock()
		defer proxiesMu.RUnlock()
		proxyList := make([]map[string]interface{}, len(globalProxies))
		for i, p := range globalProxies {
			proxyList[i] = map[string]interface{}{
				"id": p.ID, "type": p.Type, "host": p.Host, "port": p.Port,
				"user": p.User, "password": p.Password, "enabled": p.Enabled,
				"testPass": p.TestPass, "responseMs": p.ResponseMs, "lastTest": p.LastTest,
			}
		}
		json.NewEncoder(w).Encode(map[string]interface{}{
			"proxies": proxyList, "count": len(globalProxies), "enabled": len(getEnabledProxies()),
		})
	} else if r.Method == "POST" {
		var req struct {
			Action string `json:"action"`
			Proxy  struct {
				ID       string `json:"id"`
				Type     string `json:"type"`
				Host     string `json:"host"`
				Port     int    `json:"port"`
				User     string `json:"user"`
				Password string `json:"password"`
				Enabled  bool   `json:"enabled"`
			} `json:"proxy"`
		}
		json.NewDecoder(r.Body).Decode(&req)
		switch req.Action {
		case "add":
			proxyType := req.Proxy.Type
			if proxyType == "" || proxyType == "auto" {
				proxyType = detectProxyType(req.Proxy.Host, req.Proxy.Port)
			}
			newProxy := ProxyConfig{
				Type: proxyType, Host: req.Proxy.Host, Port: req.Proxy.Port,
				User: req.Proxy.User, Password: req.Proxy.Password, Enabled: req.Proxy.Enabled,
				CreatedAt: time.Now(),
			}
			addProxy(newProxy)
			proxiesMu.Lock()
			for i := range globalProxies {
				if globalProxies[i].ID == newProxy.ID {
					testProxy(&globalProxies[i])
					break
				}
			}
			proxiesMu.Unlock()
			json.NewEncoder(w).Encode(map[string]interface{}{"status": "added", "id": newProxy.ID})
		case "update":
			proxyType := req.Proxy.Type
			if proxyType == "" || proxyType == "auto" {
				proxyType = detectProxyType(req.Proxy.Host, req.Proxy.Port)
			}
			updatedProxy := ProxyConfig{
				Type: proxyType, Host: req.Proxy.Host, Port: req.Proxy.Port,
				User: req.Proxy.User, Password: req.Proxy.Password, Enabled: req.Proxy.Enabled,
			}
			updateProxy(req.Proxy.ID, updatedProxy)
			proxiesMu.Lock()
			for i := range globalProxies {
				if globalProxies[i].ID == req.Proxy.ID {
					testProxy(&globalProxies[i])
					break
				}
			}
			proxiesMu.Unlock()
			json.NewEncoder(w).Encode(map[string]interface{}{"status": "updated"})
		case "delete":
			deleteProxy(req.Proxy.ID)
			json.NewEncoder(w).Encode(map[string]interface{}{"status": "deleted"})
		case "testAll":
			go testAllProxies()
			json.NewEncoder(w).Encode(map[string]interface{}{"status": "testing"})
		}
	}
}

func handleHostIPs(w http.ResponseWriter, r *http.Request) {
	if r.Method == "GET" {
		configMu.RLock()
		defer configMu.RUnlock()
		json.NewEncoder(w).Encode(map[string]interface{}{
			"hostIPs": globalConfig.HostIPs, "activeIP": globalConfig.ActiveHostIP,
			"bestHost": GetHostRouter().GetBestHostIP(), "stats": GetHostRouter().GetAllHostStats(),
		})
	} else if r.Method == "POST" {
		var req struct {
			RawText string `json:"rawText"`
		}
		json.NewDecoder(r.Body).Decode(&req)
		lines := strings.Split(req.RawText, "\n")
		var ips []string
		for _, line := range lines {
			ip := strings.TrimSpace(line)
			if ip != "" && strings.Contains(ip, ".") {
				ips = append(ips, ip)
			}
		}
		configMu.Lock()
		globalConfig.HostIPs = ips
		configMu.Unlock()
		saveConfig()
		GetHostRouter().UpdateHostIPs(ips)
		json.NewEncoder(w).Encode(map[string]interface{}{"status": "saved", "count": len(ips)})
	}
}

func handleApplyHost(w http.ResponseWriter, r *http.Request) {
	var req struct {
		IP string `json:"ip"`
	}
	json.NewDecoder(r.Body).Decode(&req)
	if req.IP == "" {
		err := removeHostsEntry()
		if err != nil {
			json.NewEncoder(w).Encode(map[string]interface{}{"status": "error", "message": err.Error()})
			return
		}
		configMu.Lock()
		globalConfig.ActiveHostIP = ""
		configMu.Unlock()
		saveConfig()
		GetHostRouter().ResetBestHost()
		json.NewEncoder(w).Encode(map[string]interface{}{"status": "ok"})
		return
	}
	err := writeHostsEntry(req.IP)
	if err != nil {
		json.NewEncoder(w).Encode(map[string]interface{}{"status": "error", "message": err.Error()})
		return
	}
	configMu.Lock()
	globalConfig.ActiveHostIP = req.IP
	configMu.Unlock()
	saveConfig()
	json.NewEncoder(w).Encode(map[string]interface{}{"status": "ok"})
}

func handleHostStats(w http.ResponseWriter, r *http.Request) {
	stats := GetHostRouter().GetAllHostStats()
	bestHost := GetHostRouter().GetBestHostIP()
	json.NewEncoder(w).Encode(map[string]interface{}{"stats": stats, "bestHost": bestHost})
}

func handleResetHost(w http.ResponseWriter, r *http.Request) {
	GetHostRouter().ResetBestHost()
	json.NewEncoder(w).Encode(map[string]interface{}{"status": "ok"})
}

func handleRequestMode(w http.ResponseWriter, r *http.Request) {
	if r.Method == "GET" {
		configMu.RLock()
		mode := globalConfig.RequestMode
		if mode == "" {
			mode = REQUEST_MODE_SINGLE
		}
		configMu.RUnlock()
		json.NewEncoder(w).Encode(map[string]string{"mode": mode})
	} else if r.Method == "POST" {
		var req struct {
			Mode string `json:"mode"`
		}
		json.NewDecoder(r.Body).Decode(&req)
		configMu.Lock()
		if req.Mode == REQUEST_MODE_PARALLEL || req.Mode == REQUEST_MODE_SINGLE {
			globalConfig.RequestMode = req.Mode
		} else {
			globalConfig.RequestMode = REQUEST_MODE_SINGLE
		}
		configMu.Unlock()
		saveConfig()
		json.NewEncoder(w).Encode(map[string]string{"status": "saved", "mode": globalConfig.RequestMode})
	}
}

func handleParallelRetryMode(w http.ResponseWriter, r *http.Request) {
	if r.Method == "GET" {
		configMu.RLock()
		enabled := globalConfig.ParallelRetry.Signin.Enabled || 
				   globalConfig.ParallelRetry.Verify.Enabled ||
				   globalConfig.ParallelRetry.Reserve.Enabled ||
				   globalConfig.ParallelRetry.Booking.Enabled ||
				   globalConfig.ParallelRetry.Payment.Enabled
		configMu.RUnlock()
		json.NewEncoder(w).Encode(map[string]bool{"enabled": enabled})
	} else if r.Method == "POST" {
		var req struct {
			Enabled bool `json:"enabled"`
		}
		json.NewDecoder(r.Body).Decode(&req)
		configMu.Lock()
		// Enable/disable all parallel retry items
		globalConfig.ParallelRetry.Signin.Enabled = req.Enabled
		globalConfig.ParallelRetry.Verify.Enabled = req.Enabled
		globalConfig.ParallelRetry.Reserve.Enabled = req.Enabled
		globalConfig.ParallelRetry.Booking.Enabled = req.Enabled
		globalConfig.ParallelRetry.Payment.Enabled = req.Enabled
		configMu.Unlock()
		saveConfig()
		json.NewEncoder(w).Encode(map[string]bool{"enabled": req.Enabled})
	}
}

func testCaptchaHandler(w http.ResponseWriter, r *http.Request) {
	configMu.RLock()
	key := globalConfig.CaptchaAPIKey
	service := globalConfig.CaptchaService
	expiry := globalConfig.LoginCaptchaExpiry
	configMu.RUnlock()

	if key == "" {
		json.NewEncoder(w).Encode(map[string]interface{}{
			"success": false,
			"message": "Captcha API key is empty! Please add your API key in Config tab",
			"service": service,
		})
		return
	}

	q := NewSilentCaptchaQueue(key, service, 1, 1, expiry, 90, func(msg string) {
		fmt.Printf("[TEST] %s\n", msg)
	})
	defer q.Stop()

	tok, err := q.GetLoginToken()
	if err != nil {
		json.NewEncoder(w).Encode(map[string]interface{}{
			"success": false,
			"message": err.Error(),
			"service": service,
			"apiKey":  key[:min(10, len(key))] + "...",
		})
		return
	}

	if tok == "" {
		json.NewEncoder(w).Encode(map[string]interface{}{
			"success": false,
			"message": "Got empty token from captcha service",
			"service": service,
		})
		return
	}

	encrypted := encryptCaptchaForLogin(tok)
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success":      true,
		"token":        tok[:min(50, len(tok))] + "...",
		"tokenLength":  len(tok),
		"encrypted":    encrypted[:min(50, len(encrypted))] + "...",
		"encryption":   "OFFICIAL LOGIN ENCRYPTION (start_at=2, length=25)",
		"service":      service,
		"message":      fmt.Sprintf("✅ Successfully solved captcha using %s!", service),
	})
}

func testParallelHandler(w http.ResponseWriter, r *http.Request) {
	configMu.RLock()
	pc := globalConfig.Parallel
	configMu.RUnlock()
	client := getHTTPClient("")
	results := make([]map[string]interface{}, 0)
	for i := 0; i < pc.SigninHits && i < 5; i++ {
		if i > 0 && pc.SigninMs > 0 {
			time.Sleep(time.Duration(i*pc.SigninMs) * time.Millisecond)
		}
		req, _ := http.NewRequest("GET", API_BASE+"/health", nil)
		req.Header.Set("Accept", "application/json")
		start := time.Now()
		resp, err := client.Do(req)
		duration := time.Since(start)
		result := map[string]interface{}{"hit": i + 1, "duration": duration.String(), "error": nil}
		if err != nil {
			result["error"] = err.Error()
			result["status"] = 0
		} else {
			result["status"] = resp.StatusCode
			resp.Body.Close()
		}
		results = append(results, result)
	}
	json.NewEncoder(w).Encode(map[string]interface{}{"success": true, "config": pc, "results": results})
}

func testParallelRetryHandler(w http.ResponseWriter, r *http.Request) {
	configMu.RLock()
	pr := globalConfig.ParallelRetry
	configMu.RUnlock()
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"message": "Parallel retry test endpoint",
		"config":  pr,
	})
}

func handleSelectedInstances(w http.ResponseWriter, r *http.Request) {
	if r.Method != "POST" {
		w.WriteHeader(405)
		return
	}
	var req struct {
		InstanceIDs []int  `json:"instanceIds"`
		Action      string `json:"action"`
	}
	json.NewDecoder(r.Body).Decode(&req)
	go func() {
		for _, id := range req.InstanceIDs {
			instancesMu.RLock()
			inst, ok := instances[id]
			instancesMu.RUnlock()
			if !ok {
				continue
			}
			switch req.Action {
			case "start":
				inst.mu.Lock()
				if inst.Data.Status != "RUNNING" && inst.Data.Status != "COMPLETED" {
					inst.Data.Status = "RUNNING"
					inst.Data.StartTime = time.Now()
					inst.Data.Step = "STARTING"
					inst.Data.OTP = ""
					inst.Data.ReservationID = ""
					inst.Data.AppointmentDate = ""
					inst.Data.PaymentURL = ""
					inst.Data.NetworkLogs = make([]NetworkRequest, 0)
					inst.Data.RetryCount = 0
					inst.Data.ManualOTP = ""
					inst.Data.PausedStep = ""
					inst.mu.Unlock()
					ctx, cancel := context.WithCancel(context.Background())
					inst.mu.Lock()
					inst.cancel = cancel
					inst.mu.Unlock()
					go runInstanceFlow(ctx, inst, id)
				} else {
					inst.mu.Unlock()
				}
			case "stop":
				inst.mu.Lock()
				if inst.cancel != nil {
					inst.cancel()
				}
				inst.Data.Status = "STOPPED"
				inst.Data.Step = "STOPPED"
				inst.Data.PausedStep = ""
				inst.mu.Unlock()
			case "pause":
				inst.mu.Lock()
				if inst.cancel != nil && inst.Data.Status == "RUNNING" {
					inst.cancel()
					inst.Data.Status = "PAUSED"
					inst.Data.Step = "PAUSED"
					inst.Data.PausedStep = inst.Data.Step
				}
				inst.mu.Unlock()
			case "resume":
				inst.mu.Lock()
				if inst.Data.Status == "PAUSED" {
					inst.Data.Status = "RUNNING"
					inst.Data.StartTime = time.Now()
					inst.Data.Step = "RESUMING"
					inst.Data.ManualOTP = ""
					inst.mu.Unlock()
					ctx, cancel := context.WithCancel(context.Background())
					inst.mu.Lock()
					inst.cancel = cancel
					inst.mu.Unlock()
					go runInstanceFlow(ctx, inst, id)
				} else {
					inst.mu.Unlock()
				}
			case "delete":
				inst.mu.Lock()
				if inst.cancel != nil {
					inst.cancel()
				}
				inst.mu.Unlock()
				instancesMu.Lock()
				delete(instances, id)
				instancesMu.Unlock()
			}
			time.Sleep(50 * time.Millisecond)
		}
		saveInstancesToFile()
	}()
	json.NewEncoder(w).Encode(map[string]string{"status": "processing"})
}

func handleManualOTP(w http.ResponseWriter, r *http.Request) {
	if r.Method != "POST" {
		w.WriteHeader(405)
		return
	}
	var req struct {
		InstanceID int    `json:"instanceId"`
		OTP        string `json:"otp"`
	}
	json.NewDecoder(r.Body).Decode(&req)
	if req.OTP == "" {
		json.NewEncoder(w).Encode(map[string]string{"status": "error", "message": "OTP is required"})
		return
	}
	if len(req.OTP) != 6 {
		json.NewEncoder(w).Encode(map[string]string{"status": "error", "message": "OTP must be 6 digits"})
		return
	}
	instancesMu.RLock()
	inst, ok := instances[req.InstanceID]
	instancesMu.RUnlock()
	if !ok {
		json.NewEncoder(w).Encode(map[string]string{"status": "error", "message": "Instance not found"})
		return
	}
	inst.mu.Lock()
	inst.Data.ManualOTP = req.OTP
	inst.Data.ManualOTPTime = time.Now()
	inst.mu.Unlock()
	json.NewEncoder(w).Encode(map[string]string{"status": "ok", "message": "Manual OTP received"})
}

func handleSaveAppointmentID(w http.ResponseWriter, r *http.Request) {
	if r.Method != "POST" {
		w.WriteHeader(405)
		return
	}
	var req struct {
		InstanceID    int    `json:"instanceId"`
		AppointmentID string `json:"appointmentId"`
	}
	json.NewDecoder(r.Body).Decode(&req)
	instancesMu.RLock()
	inst, ok := instances[req.InstanceID]
	instancesMu.RUnlock()
	if !ok {
		json.NewEncoder(w).Encode(map[string]string{"status": "error", "message": "Instance not found"})
		return
	}
	inst.mu.Lock()
	inst.Data.AppointmentID = req.AppointmentID
	inst.Data.HasAppointmentID = req.AppointmentID != ""
	inst.mu.Unlock()
	saveInstancesToFile()
	json.NewEncoder(w).Encode(map[string]string{"status": "ok", "message": "Appointment ID saved"})
}

func startSlotMonitor() {
	slotMonitorMu.Lock()
	if slotMonitorRunning {
		slotMonitorMu.Unlock()
		return
	}
	slotMonitorRunning = true
	slotMonitorStopChan = make(chan bool)
	slotMonitorMu.Unlock()
	go func() {
		ticker := time.NewTicker(30 * time.Second)
		defer ticker.Stop()
		for {
			select {
			case <-slotMonitorStopChan:
				slotMonitorMu.Lock()
				slotMonitorRunning = false
				slotMonitorMu.Unlock()
				return
			case <-ticker.C:
				configMu.RLock()
				enabled := globalConfig.SlotMonitor.Enabled
				configMu.RUnlock()
				if !enabled {
					return
				}
				client := getHTTPClient("")
				req, _ := http.NewRequest("GET", API_SLOT_STATUS_URL, nil)
				for k, v := range browserHeaders {
					req.Header.Set(k, v)
				}
				resp, err := client.Do(req)
				if err != nil {
					return
				}
				defer resp.Body.Close()
				if resp.StatusCode == 200 {
					b, _ := io.ReadAll(resp.Body)
					var result map[string]interface{}
					json.Unmarshal(b, &result)
					slotAvailable := false
					if data, ok := result["data"].(map[string]interface{}); ok {
						if slotOpen, ok := data["slotOpen"].(bool); ok {
							slotAvailable = slotOpen
						} else if available, ok := data["available"].(bool); ok {
							slotAvailable = available
						}
					}
					broadcastUpdate(map[string]interface{}{
						"type": "slot_status", "available": slotAvailable, "data": result, "timestamp": time.Now(),
					})
				}
			}
		}
	}()
}

func stopSlotMonitor() {
	slotMonitorMu.Lock()
	defer slotMonitorMu.Unlock()
	if slotMonitorRunning && slotMonitorStopChan != nil {
		close(slotMonitorStopChan)
		slotMonitorRunning = false
	}
}

