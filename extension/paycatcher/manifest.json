{
  "manifest_version": 3,
  "name": "RJ IVAC Payment Callback Catcher",
  "version": "1.2.0",
  "description": "Captures the dg-epay callback (tran_id + data) from the network layer (like DevTools) and re-fires it until success. No external server.",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "*://api.ivacbd.com/*",
    "*://appointment.ivacbd.com/*",
    "*://*.dgepay.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RJ Payment Callback Catcher",
    "default_icon": {
      "16": "icon16.png",
      "128": "icon128.png"
    }
  }
}